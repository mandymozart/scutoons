<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests of the domain services, middleware and infrastructure (tests/Unit) on MariaDB, the production engine:
     the container of `npm run dev:db` (docker/compose.yml), run with `npm run dev:db test` (root; adds pdo_mysql when
     php.ini lacks it) or `vendor/bin/phpunit` here. The test database is emptied and migrated once per run
     (tests/Unit/MysqlTestDatabase.php); real environment variables win over these defaults (CI, a worktree's own
     TEST_DB_NAME). The HTTP contract suites (tests/*.php against a running server): composer test:contract -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <php>
        <env name="TEST_DB_HOST" value="127.0.0.1"/>
        <env name="TEST_DB_PORT" value="13306"/>
        <env name="TEST_DB_NAME" value="scutoons_test"/>
        <env name="TEST_DB_USER" value="scutoons"/>
        <env name="TEST_DB_PASS" value="scutoons"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
