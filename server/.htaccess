# Only used when the document root of api.scutoons.com is this folder (api/ on the host) instead of api/public/
# (recommended). Every request is forwarded into public/ (the web root; its .htaccess sends dynamic requests to
# public/index.php), so /api/* and the legacy /generate/ answer the same either way (docs/DEPLOY.md).
# The private folders are denied in any case, also should the forwarding below be switched off.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header (Bearer session tokens) through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Private: code, configuration, dependencies, data, logs, CLI, tests, templates, docs, local files
    RewriteRule ^(src|config|vendor|migrations|bin|tests|db|logs|storage|templates|docs)(/|$) - [R=404,L]
    RewriteRule ^(config(\.local)?\.php|config\.local\.php\.example|composer\.(json|lock)|phpunit\.xml(\.dist)?|phpstan\.neon(\.dist)?|README\.md)$ - [R=404,L]
    RewriteRule (^|/)\. - [R=404,L]

    # Everything else lives in public/
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(keypair\.json|permissions\.json|\.htpasswd|config(\.local)?\.php|.*\.sqlite.*|.*\.log|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
