{
    "name": "scutoons/server",
    "description": "SCUTOONS API (api.scutoons.com): accounts / items / content API, admin API, legacy validate + public key",
    "version": "1.0.0",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "opis/json-schema": "^2.4",
        "paragonie/sodium_compat": "^2.1",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Scutoons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scutoons\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "serve": "node bin/dev-serve.mjs",
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
