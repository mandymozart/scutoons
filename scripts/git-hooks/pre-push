#!/bin/sh
# SCUTOONS pre-push (installed by `npm run hooks` into .git/hooks): Git LFS, then the deck suite's CI on this machine
# when the pushed commits touch deck/ or shared/live* (scripts/deck-ci.mjs – owner 2026-10-31: "build before every
# push, then push"; GitHub's deck CI runs by hand only). Skip once with `git push --no-verify`.
input=$(cat)
command -v git-lfs >/dev/null 2>&1 || { echo >&2 "This repository is configured for Git LFS but 'git-lfs' was not found on your path."; exit 2; }
printf '%s\n' "$input" | git lfs pre-push "$@" || exit $?
printf '%s\n' "$input" | while read -r lref lsha rref rsha; do
	[ -z "$lsha" ] && continue
	case "$lsha" in 0000000000000000000000000000000000000000) continue ;; esac
	node scripts/deck-ci.mjs --no-release --if-changed "$rsha" "$lsha" || exit 1
done || exit 1
