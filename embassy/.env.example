# Copy to .env.development (dev only; a plain .env would also be baked into production builds). Optional: without it
# the dev build falls back to the same local URLs.
# Local ports: shared/dev-ports.json (the single source of truth); the URLs below must match it (npm run check:ports).
# The SCUTOONS API (organisations, persons, leads, activities, import). Prod fallback: https://api.scutoons.com/api
VITE_API_URL=http://localhost:9000/api
# The reader: link on the "no access" screen. Default: dev http://localhost:8000, prod https://scutoons.com
# (the deploy sets it from VITE_WWW_URL)
VITE_VIEWER_URL=http://localhost:8000
