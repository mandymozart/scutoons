// ── Option B: SQLite (zero setup) ────────────────────────────────────────
// The database file is created automatically on first request.
// Import schema manually if needed: sqlite3 db/local.sqlite < db/schema/qr.sqlite.sql

define('DB_SQLITE_PATH', __DIR__ . '/db/local.sqlite');

function getDbConnection() {
    $isNew = !file_exists(DB_SQLITE_PATH);
    $pdo   = new PDO('sqlite:' . DB_SQLITE_PATH, null, null, [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
    if ($isNew) {
        // Auto-create schema on first connection
        $pdo->exec(file_get_contents(__DIR__ . '/db/schema/qr.sqlite.sql'));
    }
    return $pdo;
}

