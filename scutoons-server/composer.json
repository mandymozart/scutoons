{
    "name": "scutoons/server",
    "description": "SCUTOONS server: QR landing page, verify page, accounts / items / content API, admin API (qr.scutoons.com)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Scutoons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scutoons\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "serve": "@php -S localhost:9100 -t public public/router.php",
        "test": [
            "@test:unit",
            "@test:contract"
        ],
        "test:unit": "@php vendor/bin/phpunit",
        "test:contract": "@php tests/run-contract.php",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
