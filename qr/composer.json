{
    "name": "scutoons/qr",
    "description": "SCUTOONS qr app (qr.scutoons.com): server-rendered QR landing page, verify page, proxies to the API. Plain PHP, no dependencies.",
    "version": "1.0.0",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "serve": "@php -S localhost:9001 -t public public/router.php",
        "test": "@php tests/public-urls.php http://localhost:9001 --api=http://localhost:9000"
    }
}
