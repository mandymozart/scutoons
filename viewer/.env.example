# Copy to .env.development (dev only; a plain .env would also be baked into production builds).
# Local ports: shared/dev-ports.json (the single source of truth); the URLs below must match it (npm run check:ports).
# Backend API (accounts, access, items, inventory, content). Prod fallback: https://api.scutoons.com/api
VITE_API_URL=http://localhost:9000/api
# Optional: object-camera summed probability threshold (default 0.2)
# VITE_SCAN_OBJECT_THRESHOLD=0.2
# CDN base for asset(). Default: dev http://localhost:8001 (scripts/dev/media-serve.mjs), prod https://cdn.scutoons.com
VITE_CDN_URL=http://localhost:8001
# The hosted Live relay /live/deck joins (#199; default wss://live.scutoons.com) – a local one per page: ?relay=ws://…
# VITE_LIVE_URL=ws://localhost:7070
# Creator app, linked from the account page for users with the creator role. Prod fallback: https://creator.scutoons.com
VITE_CREATOR_URL=http://localhost:10000
# The shop (own app): menu links, "Buy access", /shop redirect. Prod fallback: https://shop.scutoons.com
VITE_SHOP_URL=http://localhost:12000
