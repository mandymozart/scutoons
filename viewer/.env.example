# Copy to .env.development (dev only; a plain .env would also be baked into production builds).
# qr.scutoons.com API (accounts, items, inventory). Fallback: https://qr.scutoons.com/api
VITE_QR_API=http://localhost:9000/api
# Optional: cucumber-camera ImageNet probability threshold (default 0.35)
# VITE_SCAN_OBJECT_THRESHOLD=0.35
# CDN base for asset(). Default: dev http://localhost:8001 (python cdn/server.py 8001), prod https://cdn.scutoons.com
VITE_CDN_URL=http://localhost:8001
