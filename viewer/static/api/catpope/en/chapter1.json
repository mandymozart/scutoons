          "dialog": [
            {"id": "s1c1-92-1", "rect": {"x": 14.53, "y": 43.55, "width": 65.98, "height": 17.53}, "text": "Like a ray of sunshine, the choir answered through the thick clouds with “loud loud loud”, and it slowly grew brighter.", "variant": "bubble", "font": "mono", "size": 4.1, "align": "left", "valign": "top", "mask": true, "maskShape": "rect", "pad": 0.3}
