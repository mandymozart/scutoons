<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^index\.html$ - [L]
	# the app icons before their rename (2026-10-17, research/PWA.md §1): a home-screen icon or an old manifest copy still
	# asks the old names – the new files, not the SPA page
	RewriteRule ^android-chrome-(192|512)x(192|512)\.png$ /app-icon-$1.png [R=301,L]
	RewriteRule ^icon-maskable-(192|512)\.png$ /app-icon-maskable-$1.png [R=301,L]
	RewriteRule ^apple-touch-icon(-precomposed)?\.png$ /app-icon-apple-180.png [R=301,L]
	# the member's SCUTOONS MCP server ships with the API (issue 76, agents/MCP.md §3a): the short links the account page
	# and the MCP's update notice give (the old /ai/… copies are gone – owner 2026-10-20: nothing refers to them)
	RewriteRule ^mcp/?$ https://api.scutoons.com/api/mcp/download [R=302,L]
	RewriteRule ^mcp\.mcpb$ https://api.scutoons.com/api/mcp/download?file=mcpb [R=302,L]
	# the SCUTOONS Bridge plugin for Figma desktop, built with the MCP (#127, agents/MCP.md §3a)
	RewriteRule ^figma-plugin/?$ https://api.scutoons.com/api/mcp/download?file=figma-plugin [R=302,L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . /index.html [L]
</IfModule>

# Only the creator may show the reader in a frame (its Reader dock panel, BACKLOG 10.49; owner 2026-10-07: "only the
# creator page for now") – other sites can't embed scutoons.com. Add an origin here to allow another embedder.
<IfModule mod_headers.c>
	Header always set Content-Security-Policy "frame-ancestors 'self' https://creator.scutoons.com"
</IfModule>

# The Live pages cross-origin isolated (#198, shared/live-core README "Production headers"): /live/… (the browser deck,
# its wasm) and the bundled workers – live-core's audio ring shares memory with its worker. `credentialless`, so the
# page's own pictures keep loading; only there: COOP cuts window.opener, COEP blocks frames without it.
<IfModule mod_headers.c>
	# THE_REQUEST (the original request line), not REQUEST_URI: the SPA fallback above rewrites /live/… to /index.html
	# internally, and REQUEST_URI then says /index.html – the headers never came (production, 2026-10-31)
	<If "%{THE_REQUEST} =~ m#^\S+ /((de|en)/)?live/# || %{THE_REQUEST} =~ m#^\S+ /_app/immutable/workers/#">
		Header set Cross-Origin-Opener-Policy "same-origin"
		Header set Cross-Origin-Embedder-Policy "credentialless"
	</If>
</IfModule>

# The web app manifest's type (agents/research/PWA.md)
AddType application/manifest+json .webmanifest

# Caching (agents/research/PWA.md, research/LOADING.md L1): what names the build → always asked again (a 304 is cheap),
# so a deploy reaches every reader at once and the service worker's update is found; hashed app files never change
<IfModule mod_headers.c>
	<FilesMatch "^(index\.html|service-worker\.js|version\.json|site\.webmanifest)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	<If "%{REQUEST_URI} =~ m#^/_app/immutable/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	# #486: the deck's wasm and its JS glue (/live/space_web.js, …_bg.wasm, live_core.wasm) have no hash in their names –
	# always asked again, or a browser keeps an old wasm beside new app JS after a deploy
	<If "%{REQUEST_URI} =~ m#^/live/[^/]+\.(wasm|js)$#">
		Header set Cache-Control "no-cache"
	</If>
</IfModule>
