<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	
	# Allow direct access to existing files (highest priority)
	RewriteRule ^([\w\-]+\.(js|css|svg|png|jpg|jpeg|gif|woff|woff2|ttf|eot|ico|webmanifest))$ - [L]
	
	# Allow directories
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]
	
	# Rewrite everything else to index.html
	RewriteRule ^ /index.html [L]
</IfModule>
