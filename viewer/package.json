{
	"name": "scutoons-viewer",
	"version": "0.1.0",
	"scripts": {
		"dev": "vite dev",
		"build": "node ../tools/mcp/scripts/build.mjs static/ai && vite build && npm run prepack && node ../deploy/version.mjs build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "node scripts/paraglide.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run test",
		"test": "node --experimental-transform-types --no-warnings --test test/script-queue.test.ts test/expressions.test.ts test/jump-to.test.ts test/vn-safety.test.ts test/typed-code.test.ts test/strip-scroll.test.ts test/freeze-scroll.test.ts test/map-view.test.ts test/playlist.test.ts test/pickup-rules.test.ts",
		"check:watch": "node scripts/paraglide.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@inlang/paraglide-js": "^2.4.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.14",
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^8.0.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@scutoons/api": "*",
		"@scutoons/auth": "*",
		"@scutoons/content": "*",
		"@scutoons/reader": "*",
		"@scutoons/tokens": "*",
		"@tensorflow-models/mobilenet": "^2.1.1",
		"@tensorflow/tfjs": "^4.22.0",
		"@types/howler": "^2.2.12",
		"howler": "^2.2.4",
		"jsqr": "^1.4.0",
		"runed": "^0.36.0",
		"swiper": "^12.0.3"
	}
}
