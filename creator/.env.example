# Copy to .env.development (dev only; a plain .env would also be baked into production builds).
# Local ports: shared/dev-ports.json (the single source of truth); the URLs below must match it (npm run check:ports).
# Backend API (accounts, content store). Prod fallback: https://api.scutoons.com/api
VITE_API_URL=http://localhost:9000/api
# CDN base for images and audio. Default: dev http://localhost:8001, prod https://cdn.scutoons.com
VITE_CDN_URL=http://localhost:8001
# The reader: "Open the reader" link and the static /api files (toons.json, characters.json, store fallback).
# Default: dev http://localhost:8000, prod https://scutoons.com
# (old name VITE_VIEWER_URL, still read)
VITE_WWW_URL=http://localhost:8000
# The Live relay the handheld camera (phone and storyboard editor) meets on (#469). Default: wss://live.scutoons.com
# (WebSocket only until its UDP endpoint exists). A local relay: `cargo run --release -p relay -- 127.0.0.1:7070` in deck/.
# VITE_LIVE_URL=ws://127.0.0.1:7070
# Its QUIC door under another name (host:port); unset: the relay's own.
# VITE_LIVE_QUIC=udp.example:443
