# Copy to .env.development (dev only; a plain .env would also be baked into production builds).
# Backend API (accounts, content store). Prod fallback: https://qr.scutoons.com/api (later api.scutoons.com)
VITE_API_URL=http://localhost:9000/api
# CDN base for images and audio. Default: dev http://localhost:8001, prod https://cdn.scutoons.com
VITE_CDN_URL=http://localhost:8001
# The reader: "Open the reader" link and the static /api files (toons.json, characters.json, store fallback).
# Default: dev http://localhost:8000, prod https://scutoons.com
VITE_VIEWER_URL=http://localhost:8000
# Optional: static files somewhere else than <VITE_VIEWER_URL>/api
# VITE_STATIC_API=http://localhost:8000/api
