<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^index\.html$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . /index.html [L]
</IfModule>

# the creator is a tool, not public content
<IfModule mod_headers.c>
	Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# installable web app (agents/research/PWA-APPS.md): the manifest's type; what names the build is always asked again (a 304
# is cheap) so a deploy and the service worker's update reach every open tool; hashed app files never change
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
	<FilesMatch "^(index\.html|service-worker\.js|version\.json|site\.webmanifest)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	<If "%{REQUEST_URI} =~ m#^/_app/immutable/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
