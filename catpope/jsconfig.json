{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react",
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "app/**/*",
    "api/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
