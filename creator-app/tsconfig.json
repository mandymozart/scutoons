{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "CommonJS",
		"moduleResolution": "Node10",
		"rewriteRelativeImportExtensions": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"rootDir": "src",
		"outDir": "out"
	},
	"include": ["src/**/*.ts"]
}
