{
	"name": "scutoons-creator-app",
	"productName": "SCUTOONS Creator",
	"version": "0.1.0",
	"private": true,
	"description": "The SCUTOONS creator as a desktop app: a thin Electron window over creator.scutoons.com",
	"author": "SCUTOONS",
	"main": "out/main.js",
	"scripts": {
		"build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
		"start": "npm run build && electron .",
		"dist": "npm run build && electron-builder --win --config electron-builder.config.ts",
		"test": "node --experimental-transform-types --no-warnings --test test/link.test.ts test/frame.test.ts test/builder-config.test.ts"
	},
	"devDependencies": {
		"electron": "45.3.0",
		"electron-builder": "26.18.0"
	}
}
