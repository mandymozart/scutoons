# Copy to .env.development (dev only; a plain .env would also be baked into production builds).
# Local ports: shared/dev-ports.json (the single source of truth); the URLs below must match it (npm run check:ports).
# Backend API (accounts, admin API). Prod fallback: https://qr.scutoons.com/api (later api.scutoons.com).
VITE_API_URL=http://localhost:9000/api
# CDN base for images (toon avatars <CDN>/<toonId>/avatar.webp). Default: dev http://localhost:8001,
# prod https://cdn.scutoons.com
VITE_CDN_URL=http://localhost:8001
# The creator app: "Open in the creator" links on the content page. Default: dev http://localhost:10000,
# prod https://creator.scutoons.com
VITE_CREATOR_URL=http://localhost:10000
# The reader: links to toons. Default: dev http://localhost:8000, prod https://scutoons.com
VITE_VIEWER_URL=http://localhost:8000
