{
	"name": "scutoons",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "SCUTOONS monorepo: viewer, creator, admin, shop and embassy apps, shared libraries (PHP: server/ = the API with Composer, qr/ = qr.scutoons.com, plain PHP)",
	"workspaces": [
		"viewer",
		"creator",
		"admin",
		"shop",
		"embassy",
		"shared/*"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node scripts/dev/up.mjs",
		"dev:status": "node scripts/dev/up.mjs --status",
		"dev:test-user": "node scripts/dev/test-user.mjs",
		"dev:db": "node scripts/dev/db.mjs",
		"dev:launch-json": "node scripts/dev/launch-json.mjs",
		"check:creator-cast": "node scripts/dev/creator-cast-check.mjs",
		"check:creator-script": "node scripts/dev/creator-script-check.mjs",
		"check:creator-cover": "node --experimental-transform-types --no-warnings scripts/dev/creator-cover-check.mjs",
		"dev:viewer": "npm run dev -w viewer",
		"dev:creator": "npm run dev -w creator",
		"dev:admin": "npm run dev -w admin",
		"dev:shop": "npm run dev -w shop",
		"dev:embassy": "npm run dev -w embassy",
		"dev:api": "node server/bin/dev-serve.mjs",
		"dev:qr": "php scripts/dev/php-serve.php qr qr/public qr/public/router.php",
		"check": "npm run check:ports && npm run check:tools-css && npm run check --workspaces --if-present",
		"check:ports": "node scripts/dev/check-ports.mjs",
		"check:tools-css": "node scripts/check-tools-ui.mjs --static",
		"check:tools-ui": "node scripts/check-tools-ui.mjs",
		"check:fonts": "node scripts/check-fonts.mjs --session",
		"check:locale": "node scripts/check-locale.mjs",
		"check:sso": "node scripts/check-sso.mjs",
		"check:wardrobe": "node scripts/check-wardrobe.mjs",
		"check:testo": "node scripts/check-testo.mjs",
		"check:stores": "node scripts/check-stores.mjs",
		"build": "npm run build --workspaces --if-present",
		"deploy:dry-run": "node deploy/deploy.mjs all --dry-run --list=summary",
		"deploy:status": "node deploy/status.mjs",
		"deploy:changed": "node deploy/changed.mjs"
	}
}
