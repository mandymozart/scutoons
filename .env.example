# SCUTOONS — production configuration (GitHub → repo `scutoons` → Settings → Environments → `production`)
#
# This file lists EVERY value the deploy workflows need. It is a checklist, not read by any app.
# Create each entry in the GitHub environment `production`:
#   [secret]   → "Environment secrets"   (hidden)
#   [variable] → "Environment variables" (visible)
# Never put real values into this file or any committed file.
#
# Local development uses per-app files instead (not these):
#   server/config.local.php   (copy of server/config.local.php.example)
#   qr/config.local.php       (copy of qr/config.local.php.example; same QR_PROXY_SECRET as the server's)
#   viewer/.env.development, creator/.env.development, shop/.env.development, admin/.env.development,
#   embassy/.env.development (each app has its own .env.example)
#   Local dev ports: shared/dev-ports.json (the single source of truth; npm run dev starts the whole stack)
#
# Keep in sync with deploy/README.md and deploy/targets.json (the workflows pass the whole environment as JSON to
# deploy/deploy.mjs; targets.json references the names as ${NAME}).


# ── Hosting: one all-inkl FTP account, its root is the parent folder of all apps ─────────────────────────
# Used by: every deploy (viewer, creator, shop, admin, qr, api)
FTP_SERVER=                      # [secret]   all-inkl FTP host, e.g. w0xxxxxx.kasserver.com
FTP_USERNAME=                    # [secret]   FTP login whose root contains viewer/ admin/ creator/ shop/ qr/ api/
FTP_PASSWORD=                    # [secret]


# ── Database (MySQL / MariaDB at all-inkl) ─────────────────────────────────────────────────────────────────
# Used by: api (server/)
DB_HOST=                         # [variable] e.g. localhost
DB_NAME=                         # [variable] e.g. d044d724
DB_USER=                         # [secret]
DB_PASS=                         # [secret]


# ── Security ───────────────────────────────────────────────────────────────────────────────────────────────
# Used by: api (and qr for QR_PROXY_SECRET)
AUTH_SECRET=                     # [secret]   NEW random string, ≥ 32 chars — signs login codes and access tokens
QR_PROXY_SECRET=                 # [secret]   NEW random string, ≥ 32 chars — qr frontend ↔ api trust
GENERATE_PASSWORD=               # [secret]   current /generate admin password — only until the admin app replaces it


# ── Mail (login codes) — mailbox no-reply@scutoons.com, values from all-inkl KAS ─────────────────────────────
# Used by: api
MAIL_FROM=no-reply@scutoons.com             # [variable] the plain address (the sender name "SCUTOONS" is MAIL_FROM_NAME's default)
SMTP_HOST=                       # [variable] the kasserver host shown for the mailbox, e.g. w0xxxxxx.kasserver.com
SMTP_PORT=465                    # [variable] 465 (ssl) or 587 (tls)
SMTP_SECURE=ssl                  # [variable] ssl | tls
SMTP_USER=                       # [secret]   mailbox login from KAS (often m0xxxxxx)
SMTP_PASS=                       # [secret]   mailbox password


# ── Frontend URLs (baked into the static builds) ───────────────────────────────────────────────────────────
# Used by: viewer, creator, shop, admin, embassy builds; qr uses VITE_CDN_URL (item icons). Which app reads which:
# deploy/README.md "Secrets and variables" (buildEnv in deploy/targets.json)
VITE_API_URL=https://qr.scutoons.com/api     # [variable] switch to https://api.scutoons.com/api at the cutover
VITE_CDN_URL=https://cdn.scutoons.com        # [variable] later: the bunny.net / Cloudflare URL (no trailing slash)
VITE_WWW_URL=https://www.scutoons.com        # [variable]
VITE_CREATOR_URL=https://creator.scutoons.com  # [variable]
VITE_SHOP_URL=https://shop.scutoons.com      # [variable]
VITE_ADMIN_URL=https://admin.scutoons.com    # [variable]


# ── Summary ────────────────────────────────────────────────────────────────────────────────────────────────
# Secrets (10):   FTP_SERVER FTP_USERNAME FTP_PASSWORD DB_USER DB_PASS AUTH_SECRET QR_PROXY_SECRET
#                 GENERATE_PASSWORD SMTP_USER SMTP_PASS
# Variables (12): DB_HOST DB_NAME MAIL_FROM SMTP_HOST SMTP_PORT SMTP_SECURE
#                 VITE_API_URL VITE_CDN_URL VITE_WWW_URL VITE_CREATOR_URL VITE_SHOP_URL VITE_ADMIN_URL
# Not needed any more (old per-app names): CREATOR_FTP_*, SHOP_FTP_*, ADMIN_FTP_*, SERVER_FTP_DIR,
#                 VITE_VIEWER_URL (→ VITE_WWW_URL), VITE_QR_API (→ VITE_API_URL)
