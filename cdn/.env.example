# FTP Server Configuration for CDN Sync
FTP_SERVER=cdn.scutoons.com
FTP_USERNAME=your_ftp_username
FTP_PASSWORD=your_ftp_password

# Note: Copy this file to .env and fill in your actual credentials
# The .env file is gitignored for security
# 
# The sync script will automatically discover toon folders in cdn/root/
# and prompt you to select which ones to sync
