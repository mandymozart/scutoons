# Maintainer: SCUTOONS <https://scutoons.com>
# scutoons-deck – the deck suite as one Arch package (CYBERDECKS.md §3: the decks update with `pacman -Syu` from our
# own repository; #173). Builds relay, bridge, deck-check, deck-link (pairing, #180) and deck-native (the AV app the kiosk plays, #179; with its
# PipeWire backend) from this repository's deck/ workspace and installs the boot flow (deck/os/rootfs: units, scripts, PipeWire / NetworkManager config, the kiosk user).
# Build (in the repo, on Arch): `cd deck/pkg/scutoons-deck && makepkg -sf` (as a user, never root); DECK_PROFILE=lean builds the
# deck only, its features from its scenes (deck/os/profiles.toml; default full: the deck + the editor). The live ISO
# (deck/os) still copies the binaries + rootfs directly; once the repository exists it installs this package instead.
pkgname=scutoons-deck
pkgver=0.1.0
pkgrel=1
pkgdesc="SCUTOONS deck suite: Live relay, device bridge, hardware check, the stage, the kiosk boot flow"
arch=('x86_64' 'aarch64')
url="https://scutoons.com"
license=('custom:UNLICENSED')
depends=('cage' 'chromium' 'pipewire' 'wireplumber' 'rtkit' 'realtime-privileges' 'networkmanager' 'iwd'
         'vulkan-icd-loader' 'libxkbcommon' 'vulkan-tools' 'libva-utils' 'alsa-lib' 'curl' 'gptfdisk' 'squashfs-tools'
         'arch-install-scripts' 'plymouth')
depends_x86_64=('libva' 'mesa')   # VA-API video decoding (deck-media-hw): libva + libgbm
makedepends=('cargo' 'alsa-lib' 'pipewire' 'clang' 'librsvg')
makedepends_x86_64=('libva' 'mesa' 'libdrm')
backup=('etc/pipewire/pipewire.conf.d/10-deck-rt.conf'
        'etc/NetworkManager/conf.d/deck.conf'
        'etc/NetworkManager/system-connections/deck-hotspot.nmconnection')
options=('!lto')   # the workspace profile sets lto itself
# No source=(): the package is built from the checkout it lives in (deck/ = $startdir/../..). A git source
# (`git+https://github.com/mandymozart/scutoons.git`) replaces this once the repository is public to the build host.
source=()
sha256sums=()
# cros-libva 0.0.12 does not compile against libva >= 2.23's headers: its bindings come from libva 2.22's (same ABI)
source_x86_64=("libva-2.22.0-headers.pkg.tar.zst::https://archive.archlinux.org/packages/l/libva/libva-2.22.0-1-x86_64.pkg.tar.zst")
sha256sums_x86_64=('ad3083a252bbac119d405ebeea7d86f9fc8e79cc27759303300e55ac9f6ffbda')

_deck="$(cd "$startdir/../.." && pwd)"

pkgver() {
  # the workspace version + the commit, e.g. 0.1.0.r1234.gabcdef0
  local v; v=$(sed -n 's/^version = "\(.*\)"/\1/p' "$_deck/Cargo.toml" | head -1)
  printf '%s.r%s.g%s' "$v" "$(git -C "$_deck" rev-list --count HEAD 2>/dev/null || echo 0)" "$(git -C "$_deck" rev-parse --short HEAD 2>/dev/null || echo 0)"
}

_class=${DECK_PROFILE:-full}
_tool() { CARGO_TARGET_DIR="$srcdir/target" cargo run -q --release --locked -p deck-scene-features -- "$@"; }
# the deck's features: the class's platform and modules + what its system scenes need
_features() { _tool --profile os/profiles.toml "$_class" native/scenes; }
_apps() { _tool --apps os/profiles.toml "$_class" | tr ',' ' '; }

_va_headers() { if [ "$CARCH" = x86_64 ]; then export CROS_LIBVA_H_PATH="$srcdir/usr/include"; fi; }

build() {
  cd "$_deck"
  _va_headers
  local features apps; features=$(_features); apps=$(_apps)
  # three cargo lines: --no-default-features applies to every -p, and an app beside the deck must not add features to it
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked -p relay -p bridge -p deck-check -p deck-link -p deck-update
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked -p deck-native --no-default-features --features "$features"
  if [ -n "$apps" ]; then
    CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked $(printf -- '-p %s ' $apps) --features "$(echo "$features" | sed 's/[^,]*/deck-native\/&/g')"
  fi
}

check() {
  cd "$_deck"
  _va_headers
  CARGO_TARGET_DIR="$srcdir/target" cargo test --release --locked -p deck-check -p bridge -p relay -p deck-link -p deck-update
  CARGO_TARGET_DIR="$srcdir/target" cargo test --release --locked -p deck-native --no-default-features --features "$(_features)"
}

package() {
  install -Dm755 "$srcdir/target/release/relay" "$pkgdir/usr/bin/deck-relay"
  install -Dm755 "$srcdir/target/release/bridge" "$pkgdir/usr/bin/deck-bridge"
  install -Dm755 "$srcdir/target/release/deck-check" "$pkgdir/usr/bin/deck-check"
  install -Dm755 "$srcdir/target/release/deck" "$pkgdir/usr/bin/deck"
  install -Dm755 "$srcdir/target/release/deck-link" "$pkgdir/usr/bin/deck-link"
  install -Dm755 "$srcdir/target/release/deck-update" "$pkgdir/usr/bin/deck-update"
  cd "$_deck"
  case " $(_apps) " in *" deck-editor "*)
    install -Dm755 "$srcdir/target/release/deck-editor" "$pkgdir/usr/bin/deck-editor"
    install -Dm644 "$_deck/editor/tokens.toml" "$pkgdir/usr/share/deck/editor/tokens.toml"
    # the creator's `scutoons-deck://` links open the editor (DECK-LINK.md); a second start hands its link to the running one.
    # desktop-file-utils' hook registers the MimeType; `xdg-mime default scutoons-deck-editor.desktop x-scheme-handler/scutoons-deck` makes it the default
    install -Dm644 "$startdir/scutoons-deck-editor.desktop" "$pkgdir/usr/share/applications/scutoons-deck-editor.desktop"
    mkdir -p "$pkgdir/usr/share/deck/demos" && cp -r "$_deck/demos/." "$pkgdir/usr/share/deck/demos/"
  esac
  # #427: the system scenes are in the binary; a package carries no sandbox scenes (the dev image and channel do)
  # the boot flow: everything under deck/os/rootfs lands as it is laid out there
  cp -r "$_deck/os/rootfs/." "$pkgdir/"
  # what the root holds – a remote update is newer when its build is higher (#237)
  printf '{"version":"%s","build":%s}\n' "$pkgver" "$(date -u +%s)" >"$pkgdir/usr/share/deck/build.json"
  # the boot splash's logo (#179): the official SVG in white → plymouth's PNG
  rsvg-convert -w 1536 "$_deck/native/assets/SCUTOONS-logo-white.svg" -o "$pkgdir/usr/share/plymouth/themes/scutoons/logo.png"
  chmod 755 "$pkgdir"/usr/bin/deck-*
  chmod 600 "$pkgdir/etc/NetworkManager/system-connections/deck-hotspot.nmconnection"
  install -Dm644 "$_deck/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
