{
  "id": "far-nodes",
  "version": 1,
  "outlets": [{ "id": "left" }, { "id": "middle" }, { "id": "right" }],
  "rows": [
    {
      "id": "try: left cell › Open in Build › add a far node › back to Show",
      "cells": {
        "left": { "mode": "play", "piece": "character:keys", "values": { "tone:osc.gain": 0.3 } },
        "middle": { "mode": "play", "piece": "item:incense_burner" }
      }
    },
    {
      "id": "together – the keys hear the bells on right (far wire)",
      "fire": { "event": "far.together", "how": "hand" },
      "cells": {
        "left": { "mode": "values", "piece": "character:keys", "values": { "tone:osc.freq": 440 } },
        "right": { "mode": "play", "piece": "character:bells" }
      }
    },
    {
      "id": "bells alone – in Build try the Audio tab: map and tones",
      "fire": { "event": "far.end", "how": "hand" },
      "cells": { "left": { "mode": "black" }, "middle": { "mode": "black" } }
    }
  ]
}
