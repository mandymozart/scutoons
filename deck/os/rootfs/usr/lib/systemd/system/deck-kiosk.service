# cage + the stage (or the browser on the deck's page), as the user `deck` on tty1 (the cage wiki's systemd pattern: PAMName gives the
# service a logind session, so the compositor gets the seat without a display manager).
[Unit]
Description=SCUTOONS deck kiosk (cage + the stage, the browser on demand)
Requires=deck-firstboot.service
After=deck-firstboot.service systemd-user-sessions.service deck-relay.service
Conflicts=getty@tty1.service

[Service]
User=deck
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
# the boot splash steps down (keeping its last frame) right before cage takes the screen (#179); + = as root, - = fine
# without plymouth (the safe boot entries)
ExecStartPre=+-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/deck-session
Restart=on-failure
RestartSec=2
# The stop (#256): PAMName moves cage, deck-session and the stage into the logind session's scope, so systemd's SIGTERM
# reaches cage alone – the stage lost its display, deck-session took that for a crash and started the browser, cage
# waited for it until SIGKILL (90 s; X1 2026-11-01). The whole process group (cage's PID; its children share it) gets
# SIGTERM; deck-session then ends instead of looping. 5 s, then the kill – a kiosk may be killed. `${MAINPID}` braced
# (systemd leaves `-$MAINPID` unexpanded); `+` = as root, outside the PAM session (else logind refuses a second tty1).
ExecStop=+/bin/kill -TERM -- -${MAINPID}
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
