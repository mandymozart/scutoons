#!/bin/bash
# deck-tls – the venue certificate for the deck's relay (#201, deck/os/README.md "wss in the venue"): the wildcard
# *.lan.scutoons.com from the API into /var/lib/deck/tls (fullchain.pem + privkey.pem), then deck-relay restarts and
# speaks wss on 7700 next to ws. Phase A, by hand: run it once, and again after a renewal (the workflow lan-cert renews
# monthly; a certificate lives 90 days).
#   deck-tls            fetch + install + restart deck-relay
#   deck-tls --status   what is installed (names, expiry)
# The token: deck.toml's `tls_token` (`deck-set tls_token <token>`) – an admin's AI connection for now (scutoons.com →
# account → AI connections; it may only read the admin API); the deck token replaces it with #180.
# DECK_API overrides the API (default https://api.scutoons.com).
set -eu
FILE=/var/lib/deck/deck.toml
DIR=/var/lib/deck/tls
API=${DECK_API:-https://api.scutoons.com}

status() {
  if [ -r "$DIR/fullchain.pem" ]; then
    openssl x509 -in "$DIR/fullchain.pem" -noout -subject -enddate -ext subjectAltName 2>/dev/null || echo "$DIR/fullchain.pem is not a certificate"
  else
    echo "no certificate in $DIR – the relay speaks ws only"
  fi
}
[ "${1:-}" = --status ] && { status; exit 0; }
[ "$(id -u)" = 0 ] || { echo "deck-tls writes $DIR and restarts deck-relay: run it as root (tty2)"; exit 2; }

token=$(sed -n 's/^tls_token *= *"\(.*\)" *$/\1/p' "$FILE" 2>/dev/null | head -n 1)
[ -n "$token" ] || { echo "no tls_token in $FILE – deck-set tls_token <an admin's AI connection token>"; exit 2; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# one request: the chain and the key as one PEM text (GET /api/admin/lan-cert?format=pem, server/docs/API.md)
code=$(curl -sS -m 30 -o "$tmp/both.pem" -w '%{http_code}' -H "Authorization: Bearer $token" "$API/api/admin/lan-cert?format=pem") || code=000
if [ "$code" != 200 ]; then
  echo "the API answered $code:"; head -c 400 "$tmp/both.pem" 2>/dev/null; echo
  exit 1
fi
# the key's block (BEGIN … PRIVATE KEY … END) → privkey.pem, the certificates → fullchain.pem
awk -v key="$tmp/privkey.pem" -v chain="$tmp/fullchain.pem" '
  /-----BEGIN .*PRIVATE KEY-----/ { in_key = 1 }
  { if (in_key) print > key; else if ($0 != "") print > chain }
  /-----END .*PRIVATE KEY-----/ { in_key = 0 }' "$tmp/both.pem"
[ -s "$tmp/fullchain.pem" ] && [ -s "$tmp/privkey.pem" ] || { echo "the answer holds no certificate + key"; exit 1; }
openssl x509 -in "$tmp/fullchain.pem" -noout -checkend 0 >/dev/null || { echo "the certificate has expired – run the lan-cert workflow"; exit 1; }

# root owns them, the relay (user deck) reads them; the key never world-readable
install -d -m 750 -o root -g deck "$DIR"
install -m 644 -o root -g deck "$tmp/fullchain.pem" "$DIR/fullchain.pem.new"
install -m 640 -o root -g deck "$tmp/privkey.pem" "$DIR/privkey.pem.new"
mv -f "$DIR/fullchain.pem.new" "$DIR/fullchain.pem"
mv -f "$DIR/privkey.pem.new" "$DIR/privkey.pem"
status
systemctl restart deck-relay
echo "deck-relay restarted: ws + wss on 7700 (journalctl -u deck-relay)"
