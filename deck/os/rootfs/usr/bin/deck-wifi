#!/bin/bash
# The Wi-Fi picker of the boot flow (deck-firstboot step 2) – only for a deck that knows no network yet (a fresh stick;
# a deck with a remembered network skips this step and connects in the background, #251). Online after a few seconds
# (a cable) → on without asking. Otherwise a menu: nmtui's network picker, the deck's own hotspot
# (deck-hotspot.nmconnection), or no network (the local relay works without one). Later changes: nmtui on tty2.
# The splash (plymouth, #179) quits for the menu (a hidden one still eats the keys); the rest of that boot is text.
set -u

CYAN=$'\e[36m'; DIM=$'\e[2m'; OFF=$'\e[0m'

online() {
  # connectivity needs a check URL round trip; "connected" with an address is what the relay + the browser need
  nmcli -t -f STATE general 2>/dev/null | grep -q '^connected' || return 1
  ip -o -4 addr show scope global 2>/dev/null | grep -q inet
}

splash() { command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; }

# NetworkManager needs a moment after boot before a wired link is up
for _ in 1 2 3 4 5 6; do online && exit 0; sleep 1; done

if splash; then
  # quit, not hide-splash: a hidden plymouthd keeps reading tty1's keyboard, so nmtui got no Enter / Activate
  # (the X1, 2026-10-29); after the menu the boot goes on in text until the kiosk
  plymouth quit 2>/dev/null
  clear
fi

while true; do
  online && exit 0
  printf '%snot online.%s\n' "$CYAN" "$OFF"
  printf '  %sW%s  pick a Wi-Fi (nmtui)\n' "$CYAN" "$OFF"
  printf '  %sH%s  start the deck'"'"'s own hotspot (scutoons-deck / scutoons-deck)\n' "$CYAN" "$OFF"
  printf '  %sN%s  no network – go on (the local relay works; the conductor page needs one later)\n' "$CYAN" "$OFF"
  printf '  %sS%s  a shell\n' "$CYAN" "$OFF"
  read -r -p "> " -n 1 choice; echo
  case "${choice,,}" in
    w) nmtui-connect ;;
    h) nmcli connection up deck-hotspot && printf '%shotspot up:%s SSID scutoons-deck, key scutoons-deck, the deck is 10.42.0.1\n' "$CYAN" "$OFF"; sleep 2; exit 0 ;;
    n|'') exit 0 ;;
    s) printf '%sexit returns here%s\n' "$DIM" "$OFF"; /bin/bash -l ;;
  esac
done
