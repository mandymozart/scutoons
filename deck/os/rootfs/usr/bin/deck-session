#!/bin/bash
# The kiosk session (deck-kiosk.service, as the user deck): cage runs this script again inside the compositor
# ("inside"), which plays the deck's app – `kiosk` in /var/lib/deck/deck.toml:
#   "stage" (the default) – deck-stage, the native AV app (CYBERDECKS.md §8, #179); F2 in the stage starts the browser
#                           on the conductor page ON TOP of the stage (DECK_BROWSER = "deck-session browser"; cage
#                           shows the newest window): the stage keeps the logo up until the browser's window maps,
#                           then pauses and mutes; closing the browser (Ctrl+Shift+W) shows the stage at once. A stage
#                           that fails opens the browser alone.
#   "browser"             – Chromium only, as before the stage (the conductor page)
# `scene` = a scene TOML for the stage (empty = the built-in "AV madness"); `conductor` = the browser's page (empty =
# the deck's own start page: the machine report, the relay status).
set -u

STATE=/var/lib/deck
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_CONFIG_HOME="$STATE/home/.config"
export XDG_CACHE_HOME="$STATE/home/.cache"
export HOME="$STATE/home"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"

setting() { sed -n "s/^$1 *= *\"\([^\"]*\)\".*/\1/p" "$STATE/deck.toml" 2>/dev/null | head -1; }

browser() {
  local url; url=$(setting conductor)
  if [ -z "$url" ]; then
    local page="$XDG_RUNTIME_DIR/deck-start.html" relay report nets pairing wss
    relay=$(curl -s -m 2 http://127.0.0.1:7700/status 2>/dev/null || echo '(not running)')
    report=$(sed 's/&/\&amp;/g; s/</\&lt;/g' "$STATE/machine.toml" 2>/dev/null || echo '(no machine.toml)')
    nets=$(nmcli -t -f DEVICE,STATE,CONNECTION device 2>/dev/null | grep ':connected:' | tr '\n' ' ')
    # #180 / #201: the code to pair with (deck-link) and the relay's wss names (deck-tls) – no | or & in either
    pairing=$(deck-link status 2>/dev/null | tr -d '|&<' || true)
    wss=$(deck-tls --names 2>/dev/null | tr '\n' ' ' | tr -d '|&<' || true)
    sed -e "s|@HOST@|$(uname -n)|g" -e "s|@RELAY@|$relay|g" -e "s|@NETS@|${nets:-offline}|g" \
        -e "s|@PAIRING@|${pairing:-deck-link is not running}|g" -e "s|@WSS@|${wss:-no certificate yet (deck-tls)}|g" \
        -e "/@REPORT@/{r /dev/stdin
d}" /usr/share/deck/start.html <<<"$report" >"$page"
    url="file://$page"
  fi
  chromium --kiosk --ozone-platform=wayland --no-first-run --password-store=basic \
    --disable-session-crashed-bubble --disable-infobars --noerrdialogs --autoplay-policy=no-user-gesture-required \
    --user-data-dir="$XDG_CONFIG_HOME/chromium" "$url"
}

case "${1:-}" in
  inside) ;;
  browser) browser; exit $? ;;              # the stage's F2 (DECK_BROWSER), inside cage already
  # -s: VT switching stays on (Ctrl+Alt+F2 = the shell on tty2; cage blocks it without -s – X1, 2026-10-29)
  *) exec cage -s -- "$0" inside ;;
esac

mode=$(setting kiosk)
if [ "${mode:-stage}" = browser ] || ! command -v deck-stage >/dev/null; then
  browser
  exit $?
fi

scene=$(setting scene)
export DECK_BROWSER="$0 browser"
while :; do
  deck-stage --cache "$STATE/cache" ${scene:+--scene "$scene"}
  rc=$?
  case $rc in
    0) continue ;;                       # Ctrl+Q: the stage starts again
    10) browser ;;                       # F2 of a stage without DECK_BROWSER: the conductor page, then back
    *) echo "deck-stage exited with $rc – the browser instead (journalctl -u deck-kiosk)" >&2
       sleep 1; browser ;;
  esac
done
