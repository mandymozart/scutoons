#!/bin/bash
# The kiosk session (deck-kiosk.service, as the user deck): cage runs this script again inside the compositor
# ("inside"), which plays the deck's app – `kiosk` in /var/lib/deck/deck.toml:
#   "stage" (the default) – deck-native, the native AV app (CYBERDECKS.md §8, #179). A crash starts it again, never
#                           the browser.
#   "editor"              – the editor (below)
# The browser opens only on purpose: the stage's menu OPEN CREATOR (exit 12) – Chromium on `browser_url` (empty = the
# creator, "start" = the deck's own start page: the machine report, the relay status); closing it brings the stage back.
# `scene` = a scene TOML for the stage (empty = the system scene idle).
set -u

STATE=${DECK_STATE:-/var/lib/deck}
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_CONFIG_HOME="$STATE/home/.config"
export XDG_CACHE_HOME="$STATE/home/.cache"
export HOME="$STATE/home"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
# the rig modules (#406: compiled wasm instruments, `module:<name>` in a scene): the update ships them to /usr/share/deck/modules,
# the stage loads every *.wasm there at a scene's load and keeps the compiled code on DECKDATA (a restart skips the compile)
export DECK_MODULES=/usr/share/deck/modules DECK_MODULE_CACHE="$STATE/cache/modules"
mkdir -p "$DECK_MODULE_CACHE"

setting() { sed -n "s/^$1 *= *\"\([^\"]*\)\".*/\1/p" "$STATE/deck.toml" 2>/dev/null | head -1; }

browser() {
  local url; url=$(setting browser_url)
  [ -z "$url" ] && url=https://creator.scutoons.com
  if [ "$url" = start ]; then
    local page="$XDG_RUNTIME_DIR/deck-start.html" relay report nets pairing wss
    relay=$(curl -s -m 2 http://127.0.0.1:7700/status 2>/dev/null || echo '(not running)')
    report=$(sed 's/&/\&amp;/g; s/</\&lt;/g' "$STATE/machine.toml" 2>/dev/null || echo '(no machine.toml)')
    nets=$(nmcli -t -f DEVICE,STATE,CONNECTION device 2>/dev/null | grep ':connected:' | tr '\n' ' ')
    # #180 / #201: the code to pair with (deck-link) and the relay's wss names (deck-tls) – no | or & in either
    pairing=$(deck-link status 2>/dev/null | tr -d '|&<' || true)
    wss=$(deck-tls --names 2>/dev/null | tr '\n' ' ' | tr -d '|&<' || true)
    sed -e "s|@HOST@|$(uname -n)|g" -e "s|@RELAY@|$relay|g" -e "s|@NETS@|${nets:-offline}|g" \
        -e "s|@PAIRING@|${pairing:-deck-link is not running}|g" -e "s|@WSS@|${wss:-no certificate yet (deck-tls)}|g" \
        -e "/@REPORT@/{r /dev/stdin
d}" /usr/share/deck/start.html <<<"$report" >"$page"
    url="file://$page"
  fi
  chromium --kiosk --app="$url" --ozone-platform=wayland --no-first-run --password-store=basic \
    --disable-session-crashed-bubble --disable-infobars --noerrdialogs --autoplay-policy=no-user-gesture-required \
    --user-data-dir="$XDG_CONFIG_HOME/chromium"
}

# a broken image without the stage: said on tty1 and in the journal, never the browser; it waits for an update to bring it
missing() {
  local say="no deck in this image (/usr/bin/deck) – nothing to play; an update brings it (journalctl -u deck-kiosk)"
  echo "$say" >&2
  { printf '\033[2J\033[H\n  SCUTOONS DECK\n\n  %s\n  tty2 is a shell (Ctrl+Alt+F2)\n' "$say" >/dev/tty; } 2>/dev/null
}

case "${1:-}" in
  inside) ;;
  *) if ! command -v deck >/dev/null; then
       missing
       until command -v deck >/dev/null; do sleep 30; done
     fi
     # -s: VT switching stays on (Ctrl+Alt+F2 = the shell on tty2; cage blocks it without -s – X1, 2026-10-29)
     exec cage -s -- "$0" inside ;;
esac

mode=$(setting kiosk)
case "${mode:-stage}" in
  stage|editor) ;;
  browser) echo "kiosk = \"browser\" is no mode any more – the stage plays; the browser opens from its menu (OPEN CREATOR)" >&2
           mode=stage ;;
  *) echo "kiosk = \"$mode\" is no mode (stage, editor) – the stage plays" >&2
     mode=stage ;;
esac
# #560: "editor" – the editor (Show / Perform) as the kiosk app, so this deck can be the conductor: Perform, joining the
# deck's `relay`, with the `show` setting (a file or show:<id>; empty = a new show). F9 swaps (#609, deck-native
# handoff.rs): the leaving app writes the session, the show and the scene to DECK_HANDOFF and exits 11, the other starts
# with --handoff (the same file and fields as on Windows, where the app starts its sibling itself). A lean deck (no
# deck-editor) and deck.toml's `editor = "locked"` keep the stage: the stage checks both before it exits. Quitting the
# editor starts it again.
export DECK_SWAP=1 DECK_HANDOFF="$XDG_RUNTIME_DIR/deck-handoff.toml"
rm -f "$DECK_HANDOFF"
# the hand-off's flag while its file is there (the app reads it once and removes it)
handoff() { [ -f "$DECK_HANDOFF" ] && printf '%s\n' --handoff "$DECK_HANDOFF"; }
editor() {
  local relay show; relay=$(setting relay); show=$(setting show)
  local h; mapfile -t h < <(handoff)
  deck-editor --fullscreen --workspace show --tokens /usr/share/deck/editor/tokens.toml ${relay:+--relay "$relay"} ${show:+--show "$show"} "${h[@]}"
}
if [ "$mode" = editor ] && command -v deck-editor >/dev/null; then
  trap 'exit 0' TERM HUP INT
  while :; do
    editor
    rc=$?
    [ $rc = 11 ] && command -v deck >/dev/null && break   # F9: the stage below
    [ $rc = 0 ] || sleep 1
  done
fi

# a crash: the stage again after 1 s; the third within a minute waits 30 s first, so a stage that cannot start does not
# spin (the journal says each one)
crashes=()
crashed() {
  local now=$SECONDS t recent=()
  for t in "${crashes[@]}"; do [ $((now - t)) -lt 60 ] && recent+=("$t"); done
  crashes=("${recent[@]}" "$now")
  if [ ${#crashes[@]} -ge 3 ]; then
    echo "deck exited with $1 – ${#crashes[@]} crashes within a minute, the stage again in 30 s (journalctl -u deck-kiosk)" >&2
    crashes=()
    sleep 30
  else
    echo "deck exited with $1 – the stage again (journalctl -u deck-kiosk)" >&2
    sleep 1
  fi
}

scene=$(setting scene)
# the kiosk stops (deck-kiosk.service's ExecStop signals the whole group, #256): end here – the stage exits too, and
# its exit code must not read as a crash
trap 'exit 0' TERM HUP INT
while :; do
  mapfile -t h < <(handoff)
  deck --cache "$STATE/cache" ${scene:+--scene "$scene"} "${h[@]}"
  rc=$?
  case $rc in
    0) continue ;;                       # Ctrl+Q: the stage starts again
    75) echo "deck lost its display (cage went away) – the session ends, the kiosk restarts" >&2
        exit 75 ;;                       # its display is dead: nothing to start on (#257)
    11) if command -v deck-editor >/dev/null; then   # F9 – the editor; its F9 comes back here
          while :; do editor; rc=$?; [ $rc = 11 ] && break; [ $rc = 0 ] || sleep 1; done
        fi ;;
    12) browser ;;                       # OPEN CREATOR – closing the browser brings the stage back, on the hand-off
    *) crashed $rc ;;
  esac
done
