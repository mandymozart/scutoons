#!/bin/bash
# The deck's boot flow on tty1 (deck-firstboot.service; CYBERDECKS.md §3, #173):
#   1. persistence   deck-persist  – mount (or create) the DECKDATA partition at /var/lib/deck (live stick only)
#   2. network       deck-wifi     – the Wi-Fi picker (nmtui), the deck's hotspot, or "go on without"
#   3. hardware      deck-check    – GPU / Vulkan, VA-API, audio, MIDI / USB / serial, RAM, CPU → machine.toml
#   4. pairing       deck-link     – the deck's key (first boot), the code to pair with on scutoons.com (#180)
# then deck-kiosk.service takes the tty (cage + the stage, deck-session). Every step is idempotent: a second boot with a
# persistence partition, a known network and a machine.toml goes straight to the kiosk.
# Exit non-zero = the kiosk does not start; a rescue shell stays on this tty (and tty2, the serial console).
set -u

STATE=/var/lib/deck
CYAN=$'\e[36m'; RED=$'\e[31m'; DIM=$'\e[2m'; OFF=$'\e[0m'
# the boot splash (plymouth, #179): while it is up, each step is a message under the logo (the tty gets it too)
splash() { command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; }
say() {
  printf '%s[deck]%s %s\n' "$CYAN" "$OFF" "$*"
  splash && plymouth display-message --text="$(printf '%s' "$*" | sed 's/\x1b\[[0-9;]*m//g')" 2>/dev/null
  return 0
}
fail() {
  splash && plymouth quit 2>/dev/null   # the shell below needs the screen
  printf '\n%s[deck] %s%s\n' "$RED" "$*" "$OFF"
  printf '%sThe kiosk does not start. This is a shell (root); `deck-check` re-runs the check, `exit` ends it.%s\n' "$DIM" "$OFF"
  exec /bin/bash -l
}

clear
printf '\n  %sSCUTOONS deck%s · live image %s · %s\n\n' "$CYAN" "$OFF" "$(cat /etc/deck-release 2>/dev/null || echo dev)" "$(uname -r)"

# 1. persistence
say "persistence"
deck-persist || say "no persistence – this boot keeps nothing (${DIM}deck-persist said why${OFF})"
install -d -o deck -g deck "$STATE" "$STATE/home" "$STATE/cache"
[ -f "$STATE/venue.toml" ] || install -o deck -g deck -m 644 /usr/share/deck/venue.default.toml "$STATE/venue.toml"
[ -f "$STATE/deck.toml" ] || install -o deck -g deck -m 644 /usr/share/deck/deck.default.toml "$STATE/deck.toml"
# the last remote update again (#237, deck-update): a live stick's root is the ISO's after every boot (an installed deck
# has it already – nothing to do). The kiosk, bridge and link start after this script; the relay may run already.
if command -v deck-update >/dev/null; then
  upd=$(deck-update boot 2>&1)
  case "$upd" in
    re-applied*) say "$upd"; systemctl try-restart --no-block deck-relay.service ;;
    nothing*) ;;
    *) say "$upd" ;;
  esac
fi

# 2. network (deck-wifi hides the splash for its menu and says so; the logo comes back after it)
say "network"
deck-wifi
splash && plymouth show-splash 2>/dev/null

# 3. hardware check (once; `deck-check` on a shell re-runs it; RECHECK=1 on the kernel line forces it)
if [ -s "$STATE/machine.toml" ] && ! grep -qw 'deck.recheck' /proc/cmdline; then
  say "hardware: $(grep -E '^class' "$STATE/machine.toml" | head -1) – checked before, ${DIM}machine.toml kept (deck.recheck on the kernel line re-runs it)${OFF}"
else
  say "hardware check"
  if ! deck-check --out "$STATE/machine.toml"; then
    fail "deck-check: a must-have is missing (above). Not a deck until it is fixed."
  fi
  chown deck:deck "$STATE/machine.toml" 2>/dev/null || true
  sleep 3
fi

# 4. identity + pairing (#180, CYBERDECKS.md §9): the deck's own key on the persistence partition (made once: first boot;
# a stick without persistence makes a new one each boot and simply asks again), then one step of the handshake – the
# code to pair with goes under the logo and into /run/deck-link (the stage's splash shows it with a QR, deck-session's
# start page too); deck-link.service keeps going from there (renewal, revoke → a new code).
if id=$(deck-link id 2>&1); then
  say "identity ${id:0:8}…"
  pairing=$(timeout 20 deck-link once 2>&1 | tail -n 1) || true
  say "${pairing:-pairing: no answer yet – the stage shows the code once the deck is online}"
else
  say "no identity: $id"
fi

# deck-kiosk, deck-bridge and deck-link are ordered After= this service and start by themselves when it ends (never
# `systemctl start` them from here: a oneshot waiting for a unit that waits for the oneshot is a deadlock).
say "starting the kiosk ${DIM}(tty2: a shell · Ctrl+Alt+F2)${OFF}"
exit 0
