{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scutoons.com/schema/live/protocol.v1.json",
  "title": "SCUTOONS Live relay protocol v1",
  "description": "agents/research/LIVE.md B.6. One envelope per message, JSON over one WebSocket per client. The generator (deck/protocol/generate.ts) reads only the subset used here: object / string / integer / number / boolean / array / $ref / enum / const / oneOf discriminated by `kind` / additionalProperties maps. Edit this file, run `npm run generate -w shared/live`, commit both outputs.",
  "$ref": "#/definitions/Envelope",
  "definitions": {
    "Role": {
      "description": "LIVE.md B.2. `uplink` is the local relay connected to the hosted one (B.6 Uplink).",
      "type": "string",
      "enum": ["conductor", "output", "bridge", "performer", "musician", "audience", "uplink"]
    },
    "To": {
      "description": "Who a message reaches. Every field narrows; all missing = everyone the sender may reach.",
      "type": "object",
      "properties": {
        "role": { "$ref": "#/definitions/Role" },
        "group": { "type": "string", "description": "a group id (B.5.3)" },
        "client": { "type": "string", "description": "one client id (assigned in `welcome`)" }
      },
      "additionalProperties": false
    },
    "Envelope": {
      "description": "B.6: `{ v: 1, seq, at?, from, to?, kind, p }`. `seq` is per session, assigned by the relay; `at` = relay time (ms) when the effect should happen.",
      "allOf": [
        {
          "type": "object",
          "properties": {
            "v": { "type": "integer", "const": 1 },
            "seq": { "type": "integer", "minimum": 0, "description": "0 before the relay stamped it (client → relay)" },
            "at": { "type": "integer", "description": "relay time in ms when the effect should happen" },
            "from": { "type": "string", "description": "client id; `relay` for the relay's own messages" },
            "to": { "$ref": "#/definitions/To" }
          },
          "required": ["v", "seq", "from"]
        },
        { "$ref": "#/definitions/Message" }
      ]
    },
    "Message": {
      "description": "`kind` + its payload `p`. One entry per B.6 message; a loose payload (`Loose`) marks a kind whose shape is not fixed yet.",
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "hello" }, "p": { "$ref": "#/definitions/Hello" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "welcome" }, "p": { "$ref": "#/definitions/Welcome" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "ping" }, "p": { "$ref": "#/definitions/Ping" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "pong" }, "p": { "$ref": "#/definitions/Pong" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "state" }, "p": { "$ref": "#/definitions/State" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "cue" }, "p": { "$ref": "#/definitions/Cue" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "vote.open" }, "p": { "$ref": "#/definitions/VoteOpen" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "vote.close" }, "p": { "$ref": "#/definitions/VoteClose" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "vote.cast" }, "p": { "$ref": "#/definitions/VoteCast" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "vote.tally" }, "p": { "$ref": "#/definitions/VoteTally" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "vote.result" }, "p": { "$ref": "#/definitions/VoteResult" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "assign" }, "p": { "$ref": "#/definitions/Assign" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "panic" }, "p": { "$ref": "#/definitions/Panic" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "media.preload" }, "p": { "$ref": "#/definitions/MediaPreload" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "media.ready" }, "p": { "$ref": "#/definitions/MediaReady" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "snapshot" }, "p": { "$ref": "#/definitions/Snapshot" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "cell" }, "p": { "$ref": "#/definitions/CellChange" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "say" }, "p": { "$ref": "#/definitions/Loose" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "line" }, "p": { "$ref": "#/definitions/Loose" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "fx" }, "p": { "$ref": "#/definitions/Loose" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "colour" }, "p": { "$ref": "#/definitions/Loose" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "presence" }, "p": { "$ref": "#/definitions/Presence" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "ready" }, "p": { "$ref": "#/definitions/Empty" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "pickup" }, "p": { "$ref": "#/definitions/Pickup" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "react" }, "p": { "$ref": "#/definitions/React" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "device" }, "p": { "$ref": "#/definitions/Device" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "device.in" }, "p": { "$ref": "#/definitions/DeviceIn" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "devices" }, "p": { "$ref": "#/definitions/Devices" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "deck.graph" }, "p": { "$ref": "#/definitions/DeckGraph" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "deck.values" }, "p": { "$ref": "#/definitions/DeckValues" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "error" }, "p": { "$ref": "#/definitions/Error" } }, "required": ["kind", "p"] }
      ]
    },
    "Loose": {
      "description": "A payload whose shape B.6 names but this skeleton does not fix yet (say / line / fx / colour, cue actions).",
      "type": "object",
      "additionalProperties": true
    },
    "VoteRule": {
      "description": "B.11 (3): majority = most votes; groups = each group's majority is one vote; first = the first option to reach `n`.",
      "type": "string",
      "enum": ["majority", "groups", "first"]
    },
    "VoteOpen": {
      "description": "conductor → relay → the voting groups. `options` are the choice event's labels (index = option). The relay tallies, closes at `seconds` by itself and sends `vote.result`.",
      "type": "object",
      "properties": {
        "vote": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "rule": { "$ref": "#/definitions/VoteRule" },
        "n": { "type": "integer", "description": "rule first: the votes an option needs" },
        "seconds": { "type": "integer" },
        "fallback": { "type": "integer", "description": "the option when nobody voted (default 0)" },
        "groups": { "type": "array", "items": { "type": "string" }, "description": "which groups vote (default: all audience)" },
        "show": { "type": "boolean", "description": "the audience sees the tally too" }
      },
      "required": ["vote", "options", "rule", "seconds"],
      "additionalProperties": false
    },
    "VoteClose": {
      "description": "conductor → relay: close now; `override` = the conductor's option instead of the rule's.",
      "type": "object",
      "properties": { "vote": { "type": "string" }, "override": { "type": "integer" } },
      "required": ["vote"],
      "additionalProperties": false
    },
    "VoteTally": {
      "description": "relay → conductor every 250 ms while a vote is open (→ the audience too when the vote shows it).",
      "type": "object",
      "properties": {
        "vote": { "type": "string" },
        "counts": { "type": "array", "items": { "type": "integer" } },
        "voters": { "type": "integer" },
        "left": { "type": "integer", "description": "ms until the vote closes by itself" }
      },
      "required": ["vote", "counts", "voters", "left"],
      "additionalProperties": false
    },
    "VoteHow": { "type": "string", "enum": ["rule", "fallback", "override"] },
    "VoteResult": {
      "description": "relay → everyone: the option the conductor applies as the choice event (B.1).",
      "type": "object",
      "properties": {
        "vote": { "type": "string" },
        "option": { "type": "integer" },
        "counts": { "type": "array", "items": { "type": "integer" } },
        "how": { "$ref": "#/definitions/VoteHow" }
      },
      "required": ["vote", "option", "counts", "how"],
      "additionalProperties": false
    },
    "CellChange": {
      "description": "conductor → relay → the outlet's clients on a row change: the outlet's new cell (B.5.2 `Cell`, resolved by the conductor – a deck renders it natively, #186).",
      "type": "object",
      "properties": { "outlet": { "type": "string" }, "cell": { "$ref": "#/definitions/Cell" } },
      "required": ["outlet", "cell"],
      "additionalProperties": false
    },
    "Snapshot": {
      "description": "What a client shows when it joins / reconnects / is moved (B.6): the last state, the current cell per outlet it sees, the open vote, the last instruction (say) per group it sees. The conductor sees every outlet and group.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/definitions/State" },
        "cells": { "type": "object", "additionalProperties": { "$ref": "#/definitions/Cell" } },
        "media": { "type": "object", "additionalProperties": { "$ref": "#/definitions/MediaPreload" }, "description": "the last `media.preload` per outlet it sees – a reconnecting output resolves its cell's media ids with it" },
        "vote": { "$ref": "#/definitions/VoteOpen" },
        "say": { "type": "object", "additionalProperties": { "$ref": "#/definitions/Loose" } },
        "decks": { "type": "object", "additionalProperties": { "$ref": "#/definitions/DeckState" }, "description": "#188: every deck's being by client id (the conductor's snapshot)" },
        "seq": { "type": "integer", "description": "the session's seq when the snapshot was taken" }
      },
      "additionalProperties": false
    },
    "Empty": { "type": "object", "additionalProperties": false },
    "Hello": {
      "description": "client → relay, the first message. Audience / performer / musician / output join with the session code (+ group from their QR); conductor and bridge with a session token.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "role": { "$ref": "#/definitions/Role" },
        "group": { "type": "string" },
        "nick": { "type": "string", "description": "trimmed to 24 characters by the relay" },
        "token": { "type": "string", "description": "HMAC session token (conductor, bridge, uplink)" },
        "resume": { "$ref": "#/definitions/Resume" }
      },
      "required": ["code", "role"],
      "additionalProperties": false
    },
    "Resume": {
      "type": "object",
      "properties": { "client": { "type": "string" }, "seq": { "type": "integer" } },
      "required": ["client", "seq"],
      "additionalProperties": false
    },
    "Welcome": {
      "description": "relay → client after `hello`: the snapshot of what this client should show now (B.6). On a `resume` inside the replay buffer the snapshot is empty and the missed messages follow.",
      "type": "object",
      "properties": {
        "client": { "type": "string" },
        "group": { "type": "string" },
        "snapshot": { "$ref": "#/definitions/Snapshot" },
        "now": { "type": "integer", "description": "relay time, ms" }
      },
      "required": ["client", "snapshot", "now"],
      "additionalProperties": false
    },
    "Ping": { "type": "object", "properties": { "t0": { "type": "integer" } }, "required": ["t0"], "additionalProperties": false },
    "Pong": { "type": "object", "properties": { "t0": { "type": "integer" }, "t1": { "type": "integer" } }, "required": ["t0", "t1"], "additionalProperties": false },
    "State": {
      "description": "conductor → relay on every change; folded into the snapshot.",
      "type": "object",
      "properties": {
        "row": { "type": "integer" },
        "slice": { "type": "integer" },
        "vars": { "type": "object", "additionalProperties": { "type": "number" } },
        "inventory": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["row", "slice", "vars"],
      "additionalProperties": false
    },
    "Cue": {
      "description": "conductor → relay; the relay splits `actions` per outlet → `to`. Actions are loose until the show schema (B.5) lands.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/Loose" } }
      },
      "required": ["id", "actions"],
      "additionalProperties": false
    },
    "VoteCast": {
      "type": "object",
      "properties": { "vote": { "type": "string" }, "option": { "type": "integer" } },
      "required": ["vote", "option"],
      "additionalProperties": false
    },
    "Assign": {
      "type": "object",
      "properties": { "client": { "type": "string" }, "group": { "type": "string" } },
      "required": ["client", "group"],
      "additionalProperties": false
    },
    "Panic": {
      "type": "object",
      "properties": { "black": { "type": "boolean" }, "stop": { "type": "boolean" } },
      "additionalProperties": false
    },
    "MediaPreload": {
      "description": "conductor → relay → the outlet's clients before doors (LIVE.md B.5.6, #186): fetch and cache these, then answer `media.ready`. The relay keeps the last one per outlet for the snapshot.",
      "type": "object",
      "properties": { "outlet": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/definitions/MediaItem" } } },
      "required": ["outlet", "items"],
      "additionalProperties": false
    },
    "SpotMode": {
      "description": "#193: a set's spot carries rendered variants – a still, a rendered video, a 3D model; the Live view picks one.",
      "type": "string",
      "enum": ["still", "video", "model3d"]
    },
    "MediaItem": {
      "description": "One medium of a preload: `id` (what layers name as `media`) and either a `url` (show media under live/<toon>/ on the CDN, fetched with the deck token) or a set reference `set` + `spot` + `mode` (#193 – the deck resolves it: the API by id once the set model exists, today a local path / URL fallback).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "set": { "type": "string", "description": "a set id (#193: one staging of a place, e.g. `cathedral`)" },
        "spot": { "type": "string", "description": "a named spot of the set (missing = the set's default view)" },
        "mode": { "$ref": "#/definitions/SpotMode" },
        "bytes": { "type": "integer", "minimum": 0, "description": "the size, if known" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "MediaReady": {
      "description": "an outlet's client → relay → conductor: what of the outlet's preload is cached (`ready`) and what is not (`missing`, the reason per id in `why`) – the conductor's ready light. Sent after each preload and again while it retries.",
      "type": "object",
      "properties": {
        "outlet": { "type": "string" },
        "ready": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "why": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["outlet", "ready", "missing"],
      "additionalProperties": false
    },
    "CellMode": {
      "description": "B.5.2: own = the cell's layers; mirror = what outlet `of` shows; black = black (a device outlet: all off).",
      "type": "string",
      "enum": ["own", "mirror", "black"]
    },
    "Cell": {
      "description": "B.5.2 `Cell` on the wire: what one outlet shows for the current row, resolved by the conductor (toon picks as toon + chapter + slice index, live media by preload id, sets by set + spot + mode). `layers` back → front.",
      "type": "object",
      "properties": {
        "mode": { "$ref": "#/definitions/CellMode" },
        "layers": { "type": "array", "items": { "$ref": "#/definitions/Layer" } },
        "of": { "type": "string", "description": "mirror: the outlet whose cell this one shows" },
        "send": { "type": "array", "items": { "$ref": "#/definitions/DeviceMsg" }, "description": "a device outlet: the messages on row enter" }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "Layer": {
      "description": "B.5.2 `Layer`: a source in a box of the outlet. `enter` / `exit` fade it in / out when the cell changes (missing = the outlet's default crossfade); a layer with the same id and source in both cells stays.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "src": { "$ref": "#/definitions/LayerSrc" },
        "box": { "$ref": "#/definitions/LayerBox" },
        "fit": { "$ref": "#/definitions/Fit" },
        "opacity": { "type": "number", "description": "0–1 (default 1)" },
        "loop": { "type": "boolean" },
        "enter": { "$ref": "#/definitions/Transition" },
        "exit": { "$ref": "#/definitions/Transition" }
      },
      "required": ["id", "src"],
      "additionalProperties": false
    },
    "LayerBox": {
      "description": "A box in % of the outlet (a panel's crop: of the slice); x, y = the top left corner. A layer without one fills the outlet.",
      "type": "object",
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } },
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false
    },
    "Fit": { "type": "string", "enum": ["cover", "contain"] },
    "Transition": {
      "description": "A layer's fade when the cell changes, `ms` long (0 = a cut).",
      "type": "object",
      "properties": { "ms": { "type": "integer", "minimum": 0 } },
      "required": ["ms"],
      "additionalProperties": false
    },
    "LayerSrc": {
      "description": "What a layer shows (B.5.2 ToonSrc / LiveSrc, resolved). From the toon (the public library): scroll, slice, panel, surtitles. Live: video / image / model3d (a preloaded medium by id), set (a set's spot in a mode, #193), text, colour, camera.",
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "scroll" }, "p": { "$ref": "#/definitions/ToonChapter" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "slice" }, "p": { "$ref": "#/definitions/ToonSlice" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "panel" }, "p": { "$ref": "#/definitions/ToonPanel" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "surtitles" }, "p": { "$ref": "#/definitions/Surtitles" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "video" }, "p": { "$ref": "#/definitions/MediaSrc" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "image" }, "p": { "$ref": "#/definitions/MediaSrc" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "model3d" }, "p": { "$ref": "#/definitions/MediaSrc" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "set" }, "p": { "$ref": "#/definitions/SetSrc" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "text" }, "p": { "$ref": "#/definitions/TextSrc" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "colour" }, "p": { "$ref": "#/definitions/ColourSrc" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "camera" }, "p": { "$ref": "#/definitions/CameraSrc" } }, "required": ["kind", "p"] }
      ]
    },
    "ToonChapter": {
      "description": "scroll: the chapter's slices running one after the other.",
      "type": "object",
      "properties": { "toon": { "type": "string" }, "chapter": { "type": "integer", "minimum": 0 } },
      "required": ["toon", "chapter"],
      "additionalProperties": false
    },
    "ToonSlice": {
      "description": "slice: one slice; `slice` = its index in the chapter's reading order (the slices with an image, 0-based – the conductor resolves the show's pick to it).",
      "type": "object",
      "properties": { "toon": { "type": "string" }, "chapter": { "type": "integer", "minimum": 0 }, "slice": { "type": "integer", "minimum": 0 } },
      "required": ["toon", "chapter", "slice"],
      "additionalProperties": false
    },
    "ToonPanel": {
      "description": "panel: a crop of one slice (`crop` in % of the slice).",
      "type": "object",
      "properties": {
        "toon": { "type": "string" },
        "chapter": { "type": "integer", "minimum": 0 },
        "slice": { "type": "integer", "minimum": 0 },
        "crop": { "$ref": "#/definitions/LayerBox" }
      },
      "required": ["toon", "chapter", "slice", "crop"],
      "additionalProperties": false
    },
    "Surtitles": {
      "description": "surtitles: the dialog of the slice the show is on (`state.slice`, an index like ToonSlice's) in `locale`; `of` = one character's lines only.",
      "type": "object",
      "properties": {
        "toon": { "type": "string" },
        "chapter": { "type": "integer", "minimum": 0 },
        "locale": { "type": "string" },
        "of": { "type": "string" }
      },
      "required": ["toon", "chapter", "locale"],
      "additionalProperties": false
    },
    "MediaSrc": {
      "description": "a medium of the outlet's preload, by its id",
      "type": "object",
      "properties": { "media": { "type": "string" } },
      "required": ["media"],
      "additionalProperties": false
    },
    "SetSrc": {
      "description": "#193: a set's spot in a mode – a use names set + spot, never a file. still / video = the spot's rendered variant as a picture; model3d = the set as the deck's 3D space, the camera at the spot.",
      "type": "object",
      "properties": { "set": { "type": "string" }, "spot": { "type": "string" }, "mode": { "$ref": "#/definitions/SpotMode" } },
      "required": ["set", "mode"],
      "additionalProperties": false
    },
    "TextSrc": {
      "description": "text: a locale map (the deck shows its locale, else the first); `size` = the line height in % of the outlet height (default 6).",
      "type": "object",
      "properties": {
        "text": { "type": "object", "additionalProperties": { "type": "string" } },
        "size": { "type": "number" },
        "colour": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "ColourSrc": {
      "type": "object",
      "properties": { "colour": { "type": "string", "description": "#rrggbb or #rrggbbaa" } },
      "required": ["colour"],
      "additionalProperties": false
    },
    "CameraSrc": {
      "description": "camera: a video input on the output machine, by name (the deck's video-in – not built yet).",
      "type": "object",
      "properties": { "input": { "type": "string" } },
      "required": ["input"],
      "additionalProperties": false
    },
    "Presence": {
      "description": "relay → conductor: clients per group, who is ready; the decks that stream a being (#188 – a deck that left is gone from `decks`) and who sends values to whom (`routes`).",
      "type": "object",
      "properties": {
        "groups": { "type": "object", "additionalProperties": { "type": "integer" } },
        "ready": { "type": "array", "items": { "type": "string" } },
        "decks": { "type": "array", "items": { "type": "string" }, "description": "client ids with a `deck.graph`, sorted" },
        "routes": { "type": "array", "items": { "$ref": "#/definitions/Route" }, "description": "every sender → receiver pair `deck.values` went along, sorted" }
      },
      "required": ["groups", "ready"],
      "additionalProperties": false
    },
    "Route": {
      "description": "#188: a deck's values flow from client `from` to client `to` (the conductor's scene draws a hose between their beings).",
      "type": "object",
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "DeckNode": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "kind": { "type": "string", "description": "a deck-stage node kind (`fm`, `lfo`, `space` …)" } },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "DeckLink": {
      "type": "object",
      "properties": {
        "from": { "type": "string", "description": "`node.port` (an output)" },
        "to": { "type": "string", "description": "`node.port` (an input)" },
        "scale": { "type": "number" },
        "offset": { "type": "number" }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "DeckGraph": {
      "description": "#188 phase 4: a deck → relay → the conductor, on joining and when its scene changes: its being – the stage graph's nodes and links (the body), the head's character, the body's size (m), the moods calm → wild, the exposed parameters. The relay keeps the last one per client for the conductor's snapshot.",
      "type": "object",
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/DeckNode" } },
        "links": { "type": "array", "items": { "$ref": "#/definitions/DeckLink" } },
        "character": { "type": "string" },
        "size": { "type": "number" },
        "moods": { "type": "array", "items": { "type": "string" } },
        "expose": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["nodes", "links"],
      "additionalProperties": false
    },
    "DeckValues": {
      "description": "#188 phase 4 (the stream #189's sends build on): a deck → relay → the conductor (and `to`, if set), only what changed, at most 30 / s (the relay drops the rest). `values`: a path – `node.port` (a control input, a control output, an audio output's block peak) or `node.shape` (an LFO's waveform) – → a float vector (1 … n components; one today). `mood`: the head's mood when it changed. Not kept for replay: the relay folds them into the snapshot's `decks`.",
      "type": "object",
      "properties": {
        "values": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "number" } } },
        "mood": { "type": "string" }
      },
      "required": ["values"],
      "additionalProperties": false
    },
    "DeckState": {
      "description": "A deck's being in the conductor's snapshot: its graph and its latest values (all of them, folded).",
      "type": "object",
      "properties": {
        "graph": { "$ref": "#/definitions/DeckGraph" },
        "values": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "number" } } },
        "mood": { "type": "string" }
      },
      "required": ["graph", "values"],
      "additionalProperties": false
    },
    "Pickup": {
      "type": "object",
      "properties": { "item": { "type": "string" }, "placement": { "type": "string" } },
      "required": ["item", "placement"],
      "additionalProperties": false
    },
    "React": {
      "type": "object",
      "properties": { "kind": { "type": "string" } },
      "required": ["kind"],
      "additionalProperties": false
    },
    "DeviceMsg": {
      "description": "One message for a device, resolved against the venue patch. `midi`: raw bytes (status + data). `osc`: address + typed args. `dmx`: channel values of the outlet's universe (a look resolves to one per fixture).",
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "midi" }, "p": { "$ref": "#/definitions/MidiBytes" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "osc" }, "p": { "$ref": "#/definitions/OscMessage" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "dmx" }, "p": { "$ref": "#/definitions/DmxMessage" } }, "required": ["kind", "p"] }
      ]
    },
    "MidiBytes": {
      "type": "object",
      "properties": { "bytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } } },
      "required": ["bytes"],
      "additionalProperties": false
    },
    "OscArg": {
      "description": "One OSC argument, typed (JSON alone cannot tell 2 from 2.0). On the wire: int32, float32, string, bool. Blobs / timetags come when something needs them.",
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "int" }, "p": { "type": "integer" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "float" }, "p": { "type": "number" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "string" }, "p": { "type": "string" } }, "required": ["kind", "p"] },
        { "type": "object", "properties": { "kind": { "const": "bool" }, "p": { "type": "boolean" } }, "required": ["kind", "p"] }
      ]
    },
    "OscMessage": {
      "description": "An OSC message (in or out): the address pattern and its arguments. Bundles are flattened by the adapter.",
      "type": "object",
      "properties": {
        "address": { "type": "string", "description": "`/like/this`" },
        "args": { "type": "array", "items": { "$ref": "#/definitions/OscArg" } }
      },
      "required": ["address", "args"],
      "additionalProperties": false
    },
    "DmxMessage": {
      "description": "DMX out (#187): `values` from channel `ch` on (1-based; ch + values − 1 ≤ 512) in the outlet's universe; `fade` ms from the current values (missing / 0 = at once). Several ranges = several messages in `msgs`.",
      "type": "object",
      "properties": {
        "ch": { "type": "integer", "minimum": 1, "maximum": 512 },
        "values": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "fade": { "type": "integer", "minimum": 0 }
      },
      "required": ["ch", "values"],
      "additionalProperties": false
    },
    "Device": {
      "description": "relay → bridge: play `msgs` on `outlet` at `at`.",
      "type": "object",
      "properties": {
        "outlet": { "type": "string" },
        "msgs": { "type": "array", "items": { "$ref": "#/definitions/DeviceMsg" } },
        "at": { "type": "integer" }
      },
      "required": ["outlet", "msgs"],
      "additionalProperties": false
    },
    "DeviceIn": {
      "description": "bridge → conductor: MIDI / OSC in, mapped to actions there.",
      "type": "object",
      "properties": { "outlet": { "type": "string" }, "msg": { "$ref": "#/definitions/DeviceMsg" } },
      "required": ["outlet", "msg"],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string", "description": "midi · osc · dmx-artnet · …" },
        "name": { "type": "string" },
        "direction": { "type": "string", "enum": ["in", "out"] }
      },
      "required": ["adapter", "name", "direction"],
      "additionalProperties": false
    },
    "Devices": {
      "description": "bridge → relay: the ports the bridge sees, for the patch UI.",
      "type": "object",
      "properties": { "ports": { "type": "array", "items": { "$ref": "#/definitions/Port" } } },
      "required": ["ports"],
      "additionalProperties": false
    },
    "Error": {
      "description": "relay → client (not in B.6; the relay's refusals: bad hello, unknown kind, rate limit).",
      "type": "object",
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
