{
	"$comment": "Where every app is deployed – the ONE place for it (agents/PLATFORM.md 'Hosting layout & deployment'). Read by deploy/deploy.mjs, used by every workflow via .github/actions/deploy. Docs: deploy/README.md.",
	"$status_comment": "status = the URL answering with the live git_sha (version.json / API health); watch = the paths whose change needs a redeploy of that target (\"!…\" excludes). Both used by deploy/changed.mjs (what the Deploy workflow uploads) and npm run deploy:status. qr and viewer moved to their real hosts at the cutover switch (2026-10-05).",
	"order": ["api", "qr", "viewer", "shop", "creator", "admin", "embassy"],
	"protocols": {
		"ftp": {
			"$comment": "One all-inkl FTP account; its root is the deploy root. Credentials from these environment variables (GitHub environment 'production').",
			"credentials": {
				"server": "FTP_SERVER",
				"username": "FTP_USERNAME",
				"password": "FTP_PASSWORD"
			}
		}
	},
	"targets": {
		"api": {
			"description": "server/ → api.scutoons.com (docroot api/public/; root .htaccess forwards otherwise)",
			"status": "https://api.scutoons.com/api/health/",
			"watch": [
				"server/**",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "server",
			"setup": ["php"],
			"protocol": "ftp",
			"remote": "api/",
			"stageFirst": true,
			"build": "composer install --no-dev --optimize-autoloader --no-interaction --no-progress --prefer-dist",
			"include": ["**"],
			"exclude": [
				"vendor/**",
				"bin/**",
				"db/**",
				"logs/**",
				"storage/**",
				"tests/**",
				"tools/**",
				"docs/**",
				"migrations/**",
				"public/generate/**",
				".github/**",
				".phpunit.cache/**",
				".phpstan.cache/**",
				"config.php",
				"config.local.php",
				"config.local.php.example",
				"phpunit.xml.dist",
				"phpstan.neon.dist",
				"README.md",
				"CHANGELOG.md",
				"**/.htpasswd",
				"**/.git*",
				"**/.DS_Store"
			],
			"protect": [
				"storage/**",
				"db/**",
				"logs/**",
				"config.local.php",
				"**/.htpasswd"
			],
			"version": "version.json",
			"generate": {
				"config.php": {
					"format": "php-define",
					"header": "Generated by deploy/deploy.mjs – do not edit on the server. Keys: server/docs/CONFIGURATION.md",
					"values": {
						"GENERATE_PASSWORD": "${GENERATE_PASSWORD}",
						"DB_HOST": "${DB_HOST}",
						"DB_NAME": "${DB_NAME}",
						"DB_USER": "${DB_USER}",
						"DB_PASS": "${DB_PASS}",
						"AUTH_SECRET": "${AUTH_SECRET}",
						"QR_PROXY_SECRET": "${QR_PROXY_SECRET}",
						"AGENT_SERVICE_KEY": "${AGENT_SERVICE_KEY}",
						"MAIL_TRANSPORT": "smtp",
						"MAIL_FROM": "${MAIL_FROM}",
						"SMTP_HOST": "${SMTP_HOST}",
						"SMTP_PORT": "${SMTP_PORT}",
						"SMTP_SECURE": "${SMTP_SECURE}",
						"SMTP_USER": "${SMTP_USER}",
						"SMTP_PASS": "${SMTP_PASS}",
						"EMBASSY_MAIL_FROM": "${EMBASSY_MAIL_FROM}",
						"EMBASSY_MAIL_FROM_NAME": "${EMBASSY_MAIL_FROM_NAME}",
						"EMBASSY_SMTP_USER": "${EMBASSY_SMTP_USER}",
						"EMBASSY_SMTP_PASS": "${EMBASSY_SMTP_PASS}",
						"EMBASSY_CRON_KEY": "${EMBASSY_CRON_KEY}",
						"EMBASSY_URL": "${EMBASSY_URL}",
						"BUNNY_STORAGE_ZONE": "${BUNNY_STORAGE_ZONE}",
						"BUNNY_STORAGE_ENDPOINT": "${BUNNY_STORAGE_ENDPOINT}",
						"BUNNY_STORAGE_PASSWORD": "${BUNNY_STORAGE_PASSWORD}",
						"BUNNY_STORAGE_READONLY_PASSWORD": "${BUNNY_STORAGE_READONLY_PASSWORD}",
						"BUNNY_PULLZONE_ID": "${BUNNY_PULLZONE_ID}",
						"BUNNY_API_KEY": "${BUNNY_API_KEY}",
						"CDN_URL": "https://cdn.scutoons.com/",
						"CDN_PUBLIC_URL": "https://cdn.scutoons.com",
						"ALLOWED_ORIGINS": "https://scutoons.com,https://www.scutoons.com,https://creator.scutoons.com,https://admin.scutoons.com,https://shop.scutoons.com,https://embassy.scutoons.com"
					}
				}
			},
			"reminder": "Pending DB migrations are NOT run by the deploy: compare server/migrations/mysql/ with schema_migrations and run new files in phpMyAdmin first (server/docs/DATABASE.md)."
		},
		"qr": {
			"description": "qr/ → qr.scutoons.com (docroot qr/public/; root .htaccess forwards if the docroot is qr/)",
			"status": "https://qr.scutoons.com/version.json",
			"watch": [
				"qr/**",
				"shared/tokens/**",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "qr",
			"setup": [],
			"protocol": "ftp",
			"remote": "qr/",
			"stageFirst": true,
			"build": null,
			"include": ["**"],
			"exclude": [
				"tests/**",
				"bin/**",
				"cache/**",
				"config.php",
				"config.local.php",
				"config.local.php.example",
				"README.md",
				"CHANGELOG.md",
				"**/.git*",
				"**/.DS_Store"
			],
			"protect": ["cache/**", "config.local.php"],
			"version": "public/version.json",
			"generate": {
				"config.php": {
					"format": "php-return",
					"header": "Generated by deploy/deploy.mjs – do not edit on the server. Keys: qr/src/Config.php",
					"values": {
						"API_URL": "https://api.scutoons.com",
						"QR_PROXY_SECRET": "${QR_PROXY_SECRET}",
						"CDN_URL": "https://cdn.scutoons.com/",
						"PROXY_FULL_API": "0"
					}
				}
			}
		},
		"viewer": {
			"description": "viewer/ → scutoons.com, www.scutoons.com (static)",
			"status": "https://scutoons.com/version.json",
			"watch": [
				"viewer/**",
				"shared/**",
				"package.json",
				"package-lock.json",
				".npmrc",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "viewer",
			"setup": ["npm"],
			"protocol": "ftp",
			"remote": "viewer/dist/",
			"build": "npm run build -w viewer",
			"output": "viewer/build",
			"buildEnv": [
				"VITE_API_URL",
				"VITE_CDN_URL=https://cdn.scutoons.com",
				"VITE_CREATOR_URL",
				"VITE_SHOP_URL"
			],
			"include": ["**"],
			"exclude": ["**/.DS_Store"],
			"protect": [],
			"version": "version.json"
		},
		"shop": {
			"description": "shop/ → shop.scutoons.com (static)",
			"status": "https://shop.scutoons.com/version.json",
			"watch": [
				"shop/**",
				"shared/**",
				"package.json",
				"package-lock.json",
				".npmrc",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "shop",
			"setup": ["npm"],
			"protocol": "ftp",
			"remote": "shop/dist/",
			"build": "npm run build -w shop",
			"output": "shop/build",
			"buildEnv": [
				"VITE_API_URL",
				"VITE_CDN_URL=https://cdn.scutoons.com",
				"VITE_WWW_URL"
			],
			"include": ["**"],
			"exclude": ["**/.DS_Store"],
			"protect": [],
			"version": "version.json"
		},
		"creator": {
			"description": "creator/ → creator.scutoons.com (static)",
			"status": "https://creator.scutoons.com/version.json",
			"watch": [
				"creator/**",
				"shared/**",
				"package.json",
				"package-lock.json",
				".npmrc",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "creator",
			"setup": ["npm"],
			"protocol": "ftp",
			"remote": "creator/dist/",
			"build": "npm run build -w creator",
			"output": "creator/build",
			"buildEnv": [
				"VITE_API_URL",
				"VITE_CDN_URL=https://cdn.scutoons.com",
				"VITE_WWW_URL",
				"VITE_ASK_URL"
			],
			"include": ["**"],
			"exclude": ["**/.DS_Store"],
			"protect": [],
			"version": "version.json"
		},
		"admin": {
			"description": "admin/ → admin.scutoons.com (static)",
			"status": "https://admin.scutoons.com/version.json",
			"watch": [
				"admin/**",
				"shared/**",
				"package.json",
				"package-lock.json",
				".npmrc",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "admin",
			"setup": ["npm"],
			"protocol": "ftp",
			"remote": "admin/dist/",
			"build": "npm run build -w admin",
			"output": "admin/build",
			"buildEnv": [
				"VITE_API_URL",
				"VITE_CDN_URL=https://cdn.scutoons.com",
				"VITE_CREATOR_URL",
				"VITE_WWW_URL",
				"VITE_ADMIN_URL",
				"VITE_VIEWER_URL=${VITE_WWW_URL}",
				"VITE_ASK_URL"
			],
			"include": ["**"],
			"exclude": ["**/.DS_Store"],
			"protect": [],
			"version": "version.json"
		},
		"embassy": {
			"description": "embassy/ → embassy.scutoons.com (static; the partner network, roles liaison / ambassador)",
			"status": "https://embassy.scutoons.com/version.json",
			"watch": [
				"embassy/**",
				"shared/**",
				"package.json",
				"package-lock.json",
				".npmrc",
				"deploy/deploy.mjs",
				"deploy/targets.json",
				".github/workflows/deploy-app.yml"
			],
			"source": "embassy",
			"setup": ["npm"],
			"protocol": "ftp",
			"remote": "embassy/dist/",
			"build": "npm run build -w embassy",
			"output": "embassy/build",
			"buildEnv": [
				"VITE_API_URL",
				"VITE_CDN_URL=https://cdn.scutoons.com",
				"VITE_VIEWER_URL=${VITE_WWW_URL}",
				"VITE_ASK_URL"
			],
			"include": ["**"],
			"exclude": ["**/.DS_Store"],
			"protect": [],
			"version": "version.json"
		}
	}
}
