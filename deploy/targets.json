{
  "$comment": "Where every app is deployed – the ONE place for it (agents/PLATFORM.md 'Hosting layout & deployment'). Read by deploy/deploy.mjs, used by every workflow via .github/actions/deploy. Docs: deploy/README.md.",
  "$order_comment": "embassy is held back until its go-live (no subdomain on all-inkl yet; owner 2026-10-01): add it to order then, see agents/EMBASSY.md",
  "order": ["api", "qr", "viewer", "shop", "creator", "admin"],
  "protocols": {
    "ftp": {
      "$comment": "One all-inkl FTP account; its root is the deploy root. Credentials from these environment variables (GitHub environment 'production').",
      "credentials": { "server": "FTP_SERVER", "username": "FTP_USERNAME", "password": "FTP_PASSWORD" }
    }
  },
  "targets": {
    "api": {
      "description": "server/ → api.scutoons.com (docroot api/public/; root .htaccess forwards otherwise)",
      "source": "server",
      "setup": ["php"],
      "protocol": "ftp",
      "remote": "api/",
      "stageFirst": true,
      "build": "composer install --no-dev --optimize-autoloader --no-interaction --no-progress --prefer-dist",
      "include": ["**"],
      "exclude": [
        "vendor/**", "bin/**", "db/**", "logs/**", "storage/**", "tests/**", "tools/**", "docs/**", "migrations/**",
        ".github/**", ".phpunit.cache/**", ".phpstan.cache/**", "config.php", "config.local.php",
        "config.local.php.example", "phpunit.xml.dist", "phpstan.neon.dist", "README.md", "CHANGELOG.md",
        "**/.htpasswd", "**/.git*", "**/.DS_Store"
      ],
      "protect": ["storage/**", "db/**", "logs/**", "config.local.php", "**/.htpasswd"],
      "version": "version.json",
      "generate": {
        "config.php": {
          "format": "php-define",
          "header": "Generated by deploy/deploy.mjs – do not edit on the server. Keys: server/docs/CONFIGURATION.md",
          "values": {
            "GENERATE_PASSWORD": "${GENERATE_PASSWORD}",
            "DB_HOST": "${DB_HOST}",
            "DB_NAME": "${DB_NAME}",
            "DB_USER": "${DB_USER}",
            "DB_PASS": "${DB_PASS}",
            "AUTH_SECRET": "${AUTH_SECRET}",
            "QR_PROXY_SECRET": "${QR_PROXY_SECRET}",
            "MAIL_TRANSPORT": "smtp",
            "MAIL_FROM": "${MAIL_FROM}",
            "SMTP_HOST": "${SMTP_HOST}",
            "SMTP_PORT": "${SMTP_PORT}",
            "SMTP_SECURE": "${SMTP_SECURE}",
            "SMTP_USER": "${SMTP_USER}",
            "SMTP_PASS": "${SMTP_PASS}",
            "BUNNY_STORAGE_ZONE": "${BUNNY_STORAGE_ZONE}",
            "BUNNY_STORAGE_ENDPOINT": "${BUNNY_STORAGE_ENDPOINT}",
            "BUNNY_STORAGE_PASSWORD": "${BUNNY_STORAGE_PASSWORD}",
            "BUNNY_STORAGE_READONLY_PASSWORD": "${BUNNY_STORAGE_READONLY_PASSWORD}",
            "BUNNY_PULLZONE_ID": "${BUNNY_PULLZONE_ID}",
            "BUNNY_API_KEY": "${BUNNY_API_KEY}",
            "CDN_PUBLIC_URL": "${CDN_PUBLIC_URL}",
            "ALLOWED_ORIGINS": "https://scutoons.com,https://www.scutoons.com,https://creator.scutoons.com,https://admin.scutoons.com,https://shop.scutoons.com,https://embassy.scutoons.com"
          }
        }
      },
      "reminder": "Pending DB migrations are NOT run by the deploy: compare server/migrations/mysql/ with schema_migrations and run new files in phpMyAdmin first (server/docs/DATABASE.md)."
    },
    "qr": {
      "description": "qr/ → qr.scutoons.com (docroot qr/public/; root .htaccess forwards if the docroot is qr/)",
      "source": "qr",
      "setup": [],
      "protocol": "ftp",
      "remote": "qr/",
      "stageFirst": true,
      "build": null,
      "include": ["**"],
      "exclude": ["tests/**", "bin/**", "cache/**", "config.php", "config.local.php", "config.local.php.example", "README.md", "CHANGELOG.md", "**/.git*", "**/.DS_Store"],
      "protect": ["cache/**", "config.local.php"],
      "version": "public/version.json",
      "generate": {
        "config.php": {
          "format": "php-return",
          "header": "Generated by deploy/deploy.mjs – do not edit on the server. Keys: qr/src/Config.php",
          "values": {
            "API_URL": "https://api.scutoons.com",
            "QR_PROXY_SECRET": "${QR_PROXY_SECRET}",
            "PROXY_FULL_API": "1",
            "CDN_URL": "${VITE_CDN_URL}/"
          }
        }
      }
    },
    "viewer": {
      "description": "viewer/ → scutoons.com, www.scutoons.com (static)",
      "source": "viewer",
      "setup": ["npm"],
      "protocol": "ftp",
      "remote": "viewer/dist/",
      "build": "npm run build -w viewer",
      "output": "viewer/build",
      "buildEnv": ["VITE_API_URL", "VITE_CDN_URL", "VITE_CREATOR_URL", "VITE_SHOP_URL"],
      "include": ["**"],
      "exclude": ["**/.DS_Store"],
      "protect": [],
      "version": "version.json"
    },
    "shop": {
      "description": "shop/ → shop.scutoons.com (static)",
      "source": "shop",
      "setup": ["npm"],
      "protocol": "ftp",
      "remote": "shop/dist/",
      "build": "npm run build -w shop",
      "output": "shop/build",
      "buildEnv": ["VITE_API_URL", "VITE_CDN_URL", "VITE_WWW_URL"],
      "include": ["**"],
      "exclude": ["**/.DS_Store"],
      "protect": [],
      "version": "version.json"
    },
    "creator": {
      "description": "creator/ → creator.scutoons.com (static)",
      "source": "creator",
      "setup": ["npm"],
      "protocol": "ftp",
      "remote": "creator/dist/",
      "build": "npm run build -w creator",
      "output": "creator/build",
      "buildEnv": ["VITE_API_URL", "VITE_CDN_URL", "VITE_WWW_URL"],
      "include": ["**"],
      "exclude": ["**/.DS_Store"],
      "protect": [],
      "version": "version.json"
    },
    "admin": {
      "description": "admin/ → admin.scutoons.com (static)",
      "source": "admin",
      "setup": ["npm"],
      "protocol": "ftp",
      "remote": "admin/dist/",
      "build": "npm run build -w admin",
      "output": "admin/build",
      "buildEnv": ["VITE_API_URL", "VITE_CDN_URL", "VITE_CREATOR_URL", "VITE_WWW_URL", "VITE_ADMIN_URL", "VITE_VIEWER_URL=${VITE_WWW_URL}"],
      "include": ["**"],
      "exclude": ["**/.DS_Store"],
      "protect": [],
      "version": "version.json"
    },
    "embassy": {
      "description": "embassy/ → embassy.scutoons.com (static; the partner network, roles liaison / ambassador)",
      "source": "embassy",
      "setup": ["npm"],
      "protocol": "ftp",
      "remote": "embassy/dist/",
      "build": "npm run build -w embassy",
      "output": "embassy/build",
      "buildEnv": ["VITE_API_URL", "VITE_VIEWER_URL=${VITE_WWW_URL}"],
      "include": ["**"],
      "exclude": ["**/.DS_Store"],
      "protect": [],
      "version": "version.json"
    }
  }
}
