{
	"name": "@scutoons/catalog",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS catalog editors for the tools (admin, creator): the forms per kind (items, recipes, albums, products, editions, code types …), their fields, kind definitions, catalog problems, de/en texts; the app provides its locale once (setupCatalog) – agents/CATALOG-IN-CREATOR.md",
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && npm run test",
		"test": "node --experimental-transform-types --no-warnings --test test/rigs.test.ts"
	},
	"dependencies": {
		"@scutoons/api": "*",
		"@scutoons/content": "*",
		"@scutoons/media": "*",
		"@scutoons/pwa": "*",
		"@scutoons/tokens": "*",
		"@scutoons/ui": "*"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	},
	"devDependencies": {
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3"
	}
}
