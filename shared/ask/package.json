{
	"name": "@scutoons/ask",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS Ask panel: the chat with the SCUTOONS agent (tools/mcp Ask service), shared by creator, embassy and admin",
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"dependencies": {
		"@scutoons/api": "*",
		"@scutoons/ui": "*"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	},
	"devDependencies": {
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3"
	}
}
