{
	"name": "@scutoons/media",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS media tooling for the tools (creator, admin): the asset picker sheet, media slot, media-variants slot, WebP encoding + upload-or-replace, de/en texts; the app provides the assets API, CDN and locale once (setupMedia)",
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./model-view": {
			"types": "./src/model-view.d.ts",
			"default": "./src/model-view.js"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && npm run test",
		"test": "node --experimental-transform-types --no-warnings --test test/media-standard.test.ts test/media-audit.test.ts"
	},
	"dependencies": {
		"@scutoons/api": "*",
		"@scutoons/content": "*",
		"@scutoons/tokens": "*",
		"@scutoons/ui": "*",
		"three": "0.186.1",
		"wasm-media-encoders": "^0.7.0"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	},
	"devDependencies": {
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3"
	}
}
