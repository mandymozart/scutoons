{
	"name": "@scutoons/pwa",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS as installable web apps: the install rules + state of every app, the tools' app-shell service worker (creator, admin, embassy) with its page side and the install / update bars, de/en texts",
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./worker": {
			"types": "./src/worker.ts",
			"default": "./src/worker.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && npm run test",
		"test": "node --experimental-transform-types --no-warnings --test test/install-rules.test.ts test/push-rules.test.ts"
	},
	"dependencies": {
		"@scutoons/tokens": "*",
		"@scutoons/ui": "*"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	},
	"devDependencies": {
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3"
	}
}
