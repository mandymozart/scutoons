								"width": 89.15,
								"height": 24.43
							},
							"text": "Wir predigenden Wesen hatten die\nPflicht, als erste vor den\nGemein(d)en zu erscheinen und die\neigenen Rituale vor diesen zu\nerledigen. Daß gehörte eben\ndazu...",
							"variant": "narration",
							"size": 3.85,
							"mask": true,
							"maskShape": "rect",
							"pad": 0
						}
					]
				},
