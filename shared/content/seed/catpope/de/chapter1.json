								"width": 57.35,
								"height": 14.51
							},
							"text": "Nunja, bissi profan,\ntaugt aber zum\nGeschichten erzählen.",
							"variant": "caption",
							"size": 3.79,
							"mask": true,
							"maskShape": "rect",
