								"y": -9.55,
								"width": 85.56,
								"height": 17.23
							},
							"text": "Ich zwang das Klingeln in ein\nTrillern. Es vertausendfachte\nsich wie bei einem\nDMT Trip.",
							"variant": "narration",
							"size": 3.86,
							"mask": true,
							"maskShape": "rect",
							"pad": 0
						}
					]
				},
				{
					"image": "images/webtoon/s1c1/s1c1-slice-14.webp",
					"width": 390,
					"height": 625
				},
				{
