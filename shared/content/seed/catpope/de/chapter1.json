					"height": 625,
					"dialog": [
						{
							"id": "s1c1-24-1",
							"rect": {
								"x": 4.44,
								"y": 60.05,
								"width": 91.2,
								"height": 34.03
							},
							"text": "Wer bestimmt die Wahrheit?\nWer hält die Schlüssel zu den\nGeschichten?\nWo liegt der Unterschied zwischen\nmeinem Wollen und dem, was ich für\nandere inszeniere?\nWem sollte ich dienen, wenn nicht\ndrei Herren, der perfekten\nDreieinigkeit des Chaos?",
							"variant": "caption",
							"size": 3.86,
							"mask": true,
							"maskShape": "rect",
							"pad": 0
						}
					]
				},
				{
					"image": "images/webtoon/s1c1/s1c1-slice-25.webp",
					"width": 390,
					"height": 625,
					"dialog": [
						{
							"id": "s1c1-25-1",
							"rect": {
								"x": 4.44,
								"y": 25.81,
								"width": 72.48,
								"height": 31.47
							},
							"text": "Natürlich dauerte die\nLektüre länger als ich es\nwahrhaben wollte. Ich\nneigte dazu, mich im Text\nzu verlieren. Eingesaugt,\nals wäre ich\nselbst die Magd auf dem\nScheiterhaufen.",
							"variant": "narration",
							"size": 4.11,
							"mask": true,
							"maskShape": "rect",
							"pad": 0
						}
					]
				},
