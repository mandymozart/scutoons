								"x": 6.5,
								"y": 67.89,
								"width": 86.84,
								"height": 7.63
							},
							"text": "4 BEZAHLWERBUNG - SIN TONIC",
							"variant": "narration",
							"size": 3.87,
							"uppercase": true,
							"mask": true,
							"maskShape": "rect",
							"pad": 0
						}
