								"x": 6.24,
								"y": 71.57,
								"width": 57.35,
								"height": 14.51
							},
							"text": "Er machte drei Ringe\nund gab einen an\njeden Sohn?",
							"variant": "caption",
							"size": 3.85,
							"mask": true,
							"maskShape": "rect",
							"pad": 0
