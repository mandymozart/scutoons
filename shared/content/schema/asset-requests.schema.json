{
	"$id": "https://scutoons.com/schema/asset-requests.schema.json",
	"title": "AssetRequests",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$ref": "#/definitions/AssetRequests",
	"definitions": {
		"AssetRequests": {
			"type": "object",
			"properties": {
				"requests": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/AssetRequest"
					}
				}
			},
			"required": [
				"requests"
			],
			"description": "`scutoons/_/asset-requests.json`"
		},
		"AssetRequest": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"character": {
					"type": "string"
				},
				"persona": {
					"type": "string"
				},
				"look": {
					"type": "string"
				},
				"mood": {
					"type": "string"
				},
				"view": {
					"type": "string"
				},
				"path": {
					"type": "string",
					"description": "where the file should go (convention path, from the CDN root)"
				},
				"note": {
					"type": "string"
				},
				"requested_by": {
					"type": [
						"string",
						"null"
					],
					"description": "email / name of who asked"
				},
				"requested_at": {
					"type": "string",
					"description": "ISO date-time"
				},
				"status": {
					"type": "string",
					"enum": [
						"open",
						"done"
					]
				},
				"done_at": {
					"type": "string"
				}
			},
			"required": [
				"id",
				"character",
				"persona",
				"look",
				"mood",
				"view",
				"path",
				"requested_at",
				"status"
			],
			"description": "A wanted image: one cell of a look (portrait) or an A-pose look, with the convention path it should get."
		}
	}
}
