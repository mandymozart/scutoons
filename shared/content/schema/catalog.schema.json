{
	"$id": "https://scutoons.com/schema/catalog.schema.json",
	"title": "Catalog",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$ref": "#/definitions/Catalog",
	"definitions": {
		"Catalog": {
			"type": "object",
			"properties": {
				"version": {
					"type": "number"
				},
				"slots": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/AvatarSlot"
					}
				},
				"items": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/ItemDef"
					}
				},
				"recipes": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/Recipe"
					}
				},
				"stats": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/definitions/StatDef"
					},
					"description": "the reader stats substances change (`testo`, `appetite`): baseline + half-life, ITEMS.md \"Substances\""
				}
			},
			"required": [
				"version",
				"slots",
				"items",
				"recipes"
			]
		},
		"AvatarSlot": {
			"type": "string",
			"enum": [
				"head",
				"face",
				"neck",
				"torso",
				"hands",
				"legs",
				"feet",
				"back",
				"accessory"
			]
		},
		"ItemDef": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"toon": {
					"type": [
						"string",
						"null"
					]
				},
				"name": {
					"$ref": "#/definitions/Localized"
				},
				"description": {
					"$ref": "#/definitions/Localized"
				},
				"kind": {
					"$ref": "#/definitions/ItemKind"
				},
				"category": {
					"$ref": "#/definitions/ItemCategory"
				},
				"icon": {
					"type": "string"
				},
				"stackable": {
					"type": "boolean"
				},
				"starter": {
					"type": "boolean"
				},
				"grantable": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/GrantSource"
					}
				},
				"slot": {
					"anyOf": [
						{
							"$ref": "#/definitions/AvatarSlot"
						},
						{
							"type": "null"
						}
					]
				},
				"skills": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/Skill"
					}
				},
				"edition_id": {
					"type": [
						"string",
						"null"
					]
				},
				"product": {
					"type": [
						"string",
						"null"
					]
				},
				"variants": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/definitions/ItemVariant"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"wear": {
					"anyOf": [
						{
							"type": "object",
							"additionalProperties": {
								"type": "string"
							}
						},
						{
							"type": "null"
						}
					],
					"description": "Wardrobe overlays of a wearable (ITEMS.md \"Wardrobe\"): `<character>` or `<character>/<slot instance id>` → CDN path of a full-body overlay aligned to that character's A-pose (768 × 1152, transparent WebP, convention `characters/<character>/wear/<item>[-<slot instance>].webp`). A body without an overlay draws the item's icon at the slot anchor instead."
				},
				"default_worn": {
					"type": "boolean",
					"description": "Part of the basic dress (ITEMS.md \"Wardrobe\": T-shirt, shorts, sandals): a starter wearable that is put on when it is handed out (signup, older accounts, guests). A body without an overlay for it wears another starter of the same slot that has one instead (the swim pants on yellowmouse / Top Toy) – `basicDress`."
				},
				"effects": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/definitions/StatEffect"
							}
						},
						{
							"type": "null"
						}
					],
					"description": "a substance's stat changes (`catalog.stats` ids), ITEMS.md \"Substances\""
				},
				"effect": {
					"anyOf": [
						{
							"$ref": "#/definitions/TimedEffect"
						},
						{
							"type": "null"
						}
					],
					"description": "a substance's temporary reader effect"
				},
				"max": {
					"type": "number",
					"description": "Collection limit: at most this many per account (owner 2026-10-02); none = `MAX_PER_ACCOUNT` (99). Rarer items set less. The server refuses more (409 max_reached); a claimed physical product (QR code) is always added."
				}
			},
			"required": [
				"id",
				"toon",
				"name",
				"description",
				"kind",
				"category",
				"icon",
				"stackable",
				"starter",
				"grantable",
				"slot",
				"skills",
				"edition_id",
				"product",
				"variants"
			]
		},
		"Localized": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"ItemKind": {
			"type": "string",
			"enum": [
				"physical",
				"virtual"
			]
		},
		"ItemCategory": {
			"type": "string",
			"enum": [
				"tool",
				"consumable",
				"wearable",
				"collectible",
				"media",
				"substance",
				"food"
			],
			"description": "`food` = eaten with the `apply` skill (\"Essen\" instead of \"Benutzen\"), e.g. the cucumber and the tuna can lower appetite"
		},
		"GrantSource": {
			"type": "string",
			"enum": [
				"story",
				"scan"
			]
		},
		"Skill": {
			"anyOf": [
				{
					"$ref": "#/definitions/ScanQrSkill"
				},
				{
					"$ref": "#/definitions/ScanObjectSkill"
				},
				{
					"$ref": "#/definitions/MinigameSkill"
				},
				{
					"$ref": "#/definitions/PlayAudioSkill"
				},
				{
					"$ref": "#/definitions/ApplySkill"
				}
			]
		},
		"ScanQrSkill": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "scan_qr"
				}
			},
			"required": [
				"type"
			]
		},
		"ScanObjectSkill": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "scan_object"
				},
				"labels": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "ImageNet class words that count as a hit (MobileNet on the device)"
				},
				"grants": {
					"type": "string",
					"description": "the item a hit grants"
				},
				"cooldown_s": {
					"type": "number"
				},
				"per_day": {
					"type": "number",
					"description": "at most this many scan grants of `grants` per account in 24 h (server: 429 daily_limit); none = no daily limit"
				},
				"threshold": {
					"type": "number"
				},
				"name": {
					"$ref": "#/definitions/Localized",
					"description": "what the camera says it recognised for `labels` (\"Pillendose\"); none = the matched model label"
				},
				"map": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"labels": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"grants": {
								"type": "string"
							},
							"name": {
								"$ref": "#/definitions/Localized"
							}
						},
						"required": [
							"labels",
							"grants"
						]
					},
					"description": "More things to find (the multi-label Check It camera, ITEMS.md \"Substances\"): recognised labels → the item they grant, checked together with `labels` → `grants` (the best match wins) – `scanTargets` / `matchScan`."
				}
			},
			"required": [
				"type",
				"labels",
				"grants"
			]
		},
		"MinigameSkill": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "minigame"
				},
				"id": {
					"type": "string"
				}
			},
			"required": [
				"type",
				"id"
			]
		},
		"PlayAudioSkill": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "play_audio"
				},
				"src": {
					"type": "string"
				}
			},
			"required": [
				"type",
				"src"
			]
		},
		"ApplySkill": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "apply"
				}
			},
			"required": [
				"type"
			],
			"description": "\"Benutzen\" applies a substance (\"Essen\" for `food`): one piece is used up, its `effects` / `effect` hit the reader (substances.ts)"
		},
		"ItemVariant": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"$ref": "#/definitions/Localized"
				},
				"icon": {
					"type": [
						"string",
						"null"
					]
				}
			},
			"required": [
				"id",
				"name"
			]
		},
		"StatEffect": {
			"type": "object",
			"properties": {
				"stat": {
					"type": "string"
				},
				"delta": {
					"type": "number",
					"description": "added to the current (decayed) level, then clamped to 0–100"
				}
			},
			"required": [
				"stat",
				"delta"
			],
			"description": "One stat change of a substance."
		},
		"TimedEffect": {
			"type": "object",
			"properties": {
				"kind": {
					"type": "string"
				},
				"duration_min": {
					"type": "number"
				}
			},
			"required": [
				"kind",
				"duration_min"
			],
			"description": "A temporary reader effect of a substance (e.g. `psychedelic`): active until now + duration."
		},
		"Recipe": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"inputs": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/RecipePart"
					}
				},
				"output": {
					"$ref": "#/definitions/RecipePart"
				}
			},
			"required": [
				"id",
				"inputs",
				"output"
			]
		},
		"RecipePart": {
			"type": "object",
			"properties": {
				"item": {
					"type": "string"
				},
				"qty": {
					"type": "number"
				}
			},
			"required": [
				"item",
				"qty"
			]
		},
		"StatDef": {
			"type": "object",
			"properties": {
				"label": {
					"$ref": "#/definitions/Localized"
				},
				"baseline": {
					"type": "number",
					"description": "0–100, the neutral start and where the level drifts back to"
				},
				"half_life_days": {
					"type": "number",
					"description": "the distance to the baseline halves every N days"
				}
			},
			"required": [
				"label",
				"baseline",
				"half_life_days"
			],
			"description": "A reader stat (`catalog.stats.<id>`): where it rests and how fast it gets back there."
		}
	}
}
