{
	"$id": "https://scutoons.com/schema/season.schema.json",
	"title": "Season",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$ref": "#/definitions/Season",
	"definitions": {
		"Season": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string"
				},
				"authors": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"language": {
					"type": "string"
				},
				"number": {
					"type": "number"
				},
				"release": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"cover": {
					"$ref": "#/definitions/Cover"
				},
				"credits": {
					"$ref": "#/definitions/Credits"
				},
				"sequence": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/SequenceItem"
					}
				}
			},
			"required": [
				"title",
				"sequence"
			]
		},
		"Cover": {
			"type": "object",
			"properties": {
				"square": {
					"type": "string"
				},
				"portrait": {
					"type": "string"
				}
			}
		},
		"Credits": {
			"type": "object",
			"properties": {
				"artist": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"writer": {
					"type": "string"
				},
				"music": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sound": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"SequenceItem": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "chapter"
				},
				"number": {
					"type": "number"
				},
				"status": {
					"$ref": "#/definitions/Status"
				}
			},
			"required": [
				"type",
				"number",
				"status"
			]
		},
		"Status": {
			"type": "string",
			"enum": [
				"published",
				"draft",
				"coming-soon"
			]
		}
	}
}
