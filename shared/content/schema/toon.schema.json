{
	"$id": "https://scutoons.com/schema/toon.schema.json",
	"title": "Toon",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$ref": "#/definitions/Toon",
	"definitions": {
		"Toon": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"authors": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"chapters": {
					"type": "number"
				},
				"language": {
					"type": "string"
				},
				"release": {
					"type": "string"
				},
				"status": {
					"$ref": "#/definitions/Status"
				},
				"description": {
					"type": "string"
				},
				"thumbnail": {
					"type": "string"
				},
				"cover": {
					"$ref": "#/definitions/Cover"
				},
				"map": {
					"$ref": "#/definitions/Map"
				},
				"announce": {
					"type": "boolean",
					"description": "Show the toon publicly before it is published (owner 2026-10-01): the landing page's tile and the main menu list it as \"bald\" / \"soon\" (not clickable, no dates, no chapters). Language-neutral."
				},
				"tile": {
					"$ref": "#/definitions/ToonTile",
					"description": "The landing page's tile (language-neutral); without it the tile uses the toon's avatar"
				}
			},
			"required": [
				"id",
				"title",
				"authors",
				"chapters",
				"language",
				"release",
				"status",
				"description",
				"thumbnail",
				"cover",
				"map"
			]
		},
		"Status": {
			"type": "string",
			"enum": [
				"published",
				"draft",
				"coming-soon"
			]
		},
		"Cover": {
			"type": "object",
			"properties": {
				"square": {
					"type": "string"
				},
				"portrait": {
					"type": "string"
				}
			}
		},
		"Map": {
			"type": "object",
			"properties": {
				"layers": {
					"$ref": "#/definitions/MapLayers"
				},
				"width": {
					"type": "number"
				},
				"height": {
					"type": "number"
				},
				"center": {
					"$ref": "#/definitions/MapCoordinates"
				}
			},
			"required": [
				"layers",
				"width",
				"height",
				"center"
			]
		},
		"MapLayers": {
			"type": "object",
			"properties": {
				"terrain": {
					"type": "string"
				}
			},
			"required": [
				"terrain"
			]
		},
		"MapCoordinates": {
			"type": "object",
			"properties": {
				"x": {
					"type": "number"
				},
				"y": {
					"type": "number"
				}
			},
			"required": [
				"x",
				"y"
			]
		},
		"ToonTile": {
			"type": "object",
			"properties": {
				"image": {
					"type": "string",
					"description": "image path in the toon's CDN folder (`../characters/<id>/…` for a registry portrait), e.g. the star's neutral portrait"
				},
				"color": {
					"type": "string",
					"description": "CSS colour behind the image; default: the colour of the toon's star in the character registry (`own_toon`)"
				}
			},
			"required": [
				"image"
			],
			"description": "A toon's tile on the landing page: a square image on a colour"
		}
	}
}
