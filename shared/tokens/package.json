{
	"name": "@scutoons/tokens",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS design tokens (CSS custom properties), self-hosted fonts and base element styles",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": "./index.css",
		"./index.css": "./index.css",
		"./tokens.css": "./tokens.css",
		"./fonts.css": "./fonts.css",
		"./base.css": "./base.css",
		"./tools.css": "./tools.css",
		"./fonts/*": "./fonts/*",
		"./vectors.css": "./vectors.css",
		"./vectors/*": "./vectors/*",
		"./vite": "./vite.js"
	},
	"files": [
		"*.css",
		"fonts",
		"vectors",
		"vite.js"
	],
	"scripts": {
		"check": "node scripts/check.js"
	}
}
