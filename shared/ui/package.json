{
	"name": "@scutoons/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS Svelte UI kit: Button, IconButton, Field, Panel, Section, Sheet, Tabs, Toggle, Badge, Menu, Toasts, ActionBar, InfoPanel, DataTable, Pager, SplitView, CommandPalette, Skeleton, Chart, RecordInspector, ToonAvatar",
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"dependencies": {
		"@scutoons/tokens": "*",
		"feather-icons": "^4.29.2"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	},
	"devDependencies": {
		"@types/feather-icons": "^4.29.4",
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3"
	}
}
