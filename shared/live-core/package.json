{
	"name": "@scutoons/live-core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS Live: the browser engine (#184) – deck-core as wasm (deck/live-core) in a Web Worker, audio through an AudioWorklet + SharedArrayBuffer ring, binary wire records across the boundary",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./worker": "./src/worker.ts",
		"./worklet": "./src/worklet.ts",
		"./engine": "./src/engine.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path ../../deck/Cargo.toml -p live-core",
		"check": "tsc --noEmit -p tsconfig.json && npm run test",
		"test": "node --experimental-transform-types --no-warnings --test test/wire.test.ts test/ring.test.ts test/engine.test.ts test/stats.test.ts"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}
