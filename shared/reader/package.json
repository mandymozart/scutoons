{
	"name": "@scutoons/reader",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SCUTOONS reader rendering shared by viewer and creator: Slice, Dialogs (text boxes, revealed onomatopoeia), placed items, pure slice actions",
	"sideEffects": [
		"**/*.css",
		"**/*.svelte"
	],
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./score": {
			"types": "./src/score/index.ts",
			"svelte": "./src/score/index.ts",
			"default": "./src/score/index.ts"
		},
		"./score-anchors": {
			"types": "./src/score/anchors.ts",
			"default": "./src/score/anchors.ts"
		},
		"./score-lab": {
			"types": "./src/score/lab.ts",
			"svelte": "./src/score/lab.ts",
			"default": "./src/score/lab.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && npm run test",
		"test": "node --experimental-transform-types --no-warnings --test test/score-synth.test.ts test/score-pages.test.ts test/collage-css.test.ts test/score-anchors.test.ts test/score-reflow.test.ts"
	},
	"dependencies": {
		"@scutoons/content": "*",
		"@scutoons/ui": "*",
		"verovio": "6.3.0"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	},
	"devDependencies": {
		"svelte": "^5.55.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.9.3"
	}
}
