RewriteEngine On

# Allow direct access to API routes
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ api/$1 [L]

# Direct access to /generate shows the form
RewriteRule ^generate/?$ generate/index.php [L]

# Allow access to generate directory files
RewriteRule ^generate/(.+)$ generate/$1 [L]

# Route QR code parameters to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/generate
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ index.php [L,QSA]
